#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Элементы.ГруппаЗамещение.Видимость = (Объект.МетодПриема = "Замещение");

	// Для нового документа считаем оклад по формуле.
	Если Объект.Оклад = 0 Тогда
		ПересчитатьОклад();
	КонецЕсли;

	ПересчитатьКоличествоЛет();

	ИтогиНачислений = ТекстИтоговНачислений();
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Если Объект.ДатаПриема = '00010101' Тогда
		Сообщить("Не заполнена дата приема.");
		Отказ = Истина;
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.КонецИспытательногоСрока)
		И Объект.КонецИспытательногоСрока < Объект.НачалоИспытательногоСрока Тогда
		Сообщить("Конец испытательного срока меньше начала.");
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)

	Если ИсточникВыбора.ИмяФормы = "Документ.ПриемНаРаботу.Форма.ФормаПодбораЗамещающих" Тогда
		Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
			Объект.ОтсутствующийСотрудник      = ВыбранноеЗначение.Сотрудник;
			Объект.ПодразделениеОтсутствующего = ВыбранноеЗначение.Подразделение;
			Объект.ДолжностьОтсутствующего     = ВыбранноеЗначение.Должность;
			Объект.ПричинаОтсутствия           = ВыбранноеЗначение.ПричинаОтсутствия;
		КонецЕсли;

	ИначеЕсли ИсточникВыбора.ИмяФормы = "Документ.ПриемНаРаботу.Форма.ФормаПодбораОснований" Тогда
		Объект.ПричинаОтсутствия = ВыбранноеЗначение;

	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура СотрудникПриИзменении(Элемент)
	ЗаполнитьВидКомплектования();
КонецПроцедуры

&НаКлиенте
Процедура МетодПриемаПриИзменении(Элемент)

	// Блок замещения показываем только для метода приема «Замещение».
	Элементы.ГруппаЗамещение.Видимость = (Объект.МетодПриема = "Замещение");

	Если Объект.МетодПриема = "Замещение" И Не ЗначениеЗаполнено(Объект.ОтсутствующийСотрудник) Тогда
		ПодобратьЗамещающих(Неопределено);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОкладПриИзменении(Элемент)
	ОбновитьИтогиНачислений();
КонецПроцедуры

&НаКлиенте
Процедура СтавкаПриИзменении(Элемент)
	ПересчитатьОклад();
	ОбновитьИтогиНачислений();
КонецПроцедуры

&НаКлиенте
Процедура ДолжностьПриИзменении(Элемент)
	ПересчитатьОклад();
	ОбновитьИтогиНачислений();
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриемаПриИзменении(Элемент)
	ПересчитатьКоличествоЛет();
КонецПроцедуры

&НаКлиенте
Процедура ДатаУвольненияПриИзменении(Элемент)
	ПересчитатьКоличествоЛет();
КонецПроцедуры

&НаКлиенте
Процедура РазмерПриИзменении(Элемент)
	ОбновитьИтогиНачислений();
КонецПроцедуры

&НаКлиенте
Процедура НадбавкаПриИзменении(Элемент)

	ТекущаяСтрока = Элементы.Надбавки.ТекущиеДанные;
	Если ТекущаяСтрока <> Неопределено И ЗначениеЗаполнено(ТекущаяСтрока.Надбавка) Тогда

		ТекущаяСтрока.ЕдИзм = ЕдИзмНадбавкиНаСервере(ТекущаяСтрока.Надбавка);

		Если Не ЗначениеЗаполнено(ТекущаяСтрока.Начало) Тогда
			ТекущаяСтрока.Начало = ?(ЗначениеЗаполнено(Объект.ДатаПриема), Объект.ДатаПриема, Объект.Дата);
		КонецЕсли;

	КонецЕсли;

	ОбновитьИтогиНачислений();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПроверитьСтавки(Команда)

	// Свободные ставки смотрим на дату приема, а если она не заполнена — на дату документа.
	ДатаОстатков = Объект.ДатаПриема;
	Если Не ЗначениеЗаполнено(ДатаОстатков) Тогда
		ДатаОстатков = Объект.Дата;
	КонецЕсли;

	ПараметрыФормы = Новый Структура("Подразделение, Должность, ДатаОстатков",
		Объект.Подразделение, Объект.Должность, ДатаОстатков);
	ОткрытьФорму("Документ.ПриемНаРаботу.Форма.ФормаПросмотраСтавок", ПараметрыФормы, ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ПодобратьЗамещающих(Команда)
	ОткрытьФорму("Документ.ПриемНаРаботу.Форма.ФормаПодбораЗамещающих", , ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ПодобратьОснования(Команда)
	ОткрытьФорму("Документ.ПриемНаРаботу.Форма.ФормаПодбораОснований", , ЭтаФорма);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заполняет вид комплектования по карточке выбранного сотрудника.
&НаСервере
Процедура ЗаполнитьВидКомплектования()
	Если ЗначениеЗаполнено(Объект.Сотрудник) Тогда
		Объект.ВидКомплектования = Объект.Сотрудник.ВидКомплектования;
	КонецЕсли;
КонецПроцедуры

// Возвращает единицу измерения надбавки. Вызывается с клиента:
// обращаться к реквизитам ссылки из клиентского кода нельзя.
&НаСервере
Функция ЕдИзмНадбавкиНаСервере(Надбавка)
	Возврат Надбавка.ЕдИзм;
КонецФункции

// Оклад = БазоваяСтавка * Разряд должности * Ставка.
&НаСервере
Процедура ПересчитатьОклад()
	Если Не ЗначениеЗаполнено(Объект.Должность) Тогда
		Возврат;
	КонецЕсли;
	Объект.Оклад = БазоваяСтавкаЗначение() * Объект.Должность.Разряд * Объект.Ставка;
КонецПроцедуры

// Значение константы «Базовая ставка». Если она еще не задана — 100.
&НаСервере
Функция БазоваяСтавкаЗначение()
	Значение = Константы.БазоваяСтавка.Получить();
	Если Значение = 0 Тогда
		Значение = 100;
		Константы.БазоваяСтавка.Установить(Значение);
	КонецЕсли;
	Возврат Значение;
КонецФункции

// Количество лет = Дата увольнения - Дата приема (полных лет).
&НаСервере
Процедура ПересчитатьКоличествоЛет()
	Если ЗначениеЗаполнено(Объект.ДатаПриема) И ЗначениеЗаполнено(Объект.ДатаУвольнения) Тогда
		Объект.КоличествоЛет = КоличествоПолныхЛет(Объект.ДатаУвольнения, Объект.ДатаПриема);
	Иначе
		Объект.КоличествоЛет = 0;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция КоличествоПолныхЛет(ДатаКонца, ДатаНачала)
	Лет = Год(ДатаКонца) - Год(ДатаНачала);
	Если Месяц(ДатаКонца) < Месяц(ДатаНачала)
		ИЛИ (Месяц(ДатаКонца) = Месяц(ДатаНачала) И День(ДатаКонца) < День(ДатаНачала)) Тогда
		Лет = Лет - 1;
	КонецЕсли;
	Возврат Лет;
КонецФункции

&НаКлиенте
Процедура ОбновитьИтогиНачислений()
	ИтогиНачислений = ТекстИтоговНачислений();
КонецПроцедуры

// Сводка по вкладке «Начисления»: оклад, сумма надбавок и план. зарплата.
&НаСервере
Функция ТекстИтоговНачислений()

	СуммаНадбавок = 0;
	Для Каждого СтрокаНадбавки Из Объект.Надбавки Цикл
		СуммаНадбавок = СуммаНадбавок + СтрокаНадбавки.Размер;
	КонецЦикла;

	Возврат "Оклад: " + Строка(Объект.Оклад)
		+ "   |   Сумма надбавок: " + Строка(СуммаНадбавок)
		+ "   |   План. зарплата: " + Строка(Объект.Оклад + СуммаНадбавок);

КонецФункции

#КонецОбласти
