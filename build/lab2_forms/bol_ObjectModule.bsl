// Формирует движения по регистру «Больничные периоды»:
// период больничного с датой начала в качестве периода записи.
Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Движения.БольничныеПериоды.Записывать = Истина;

	Для Каждого СтрокаБольничного Из Сотрудники Цикл

		Если Не ЗначениеЗаполнено(СтрокаБольничного.Сотрудник) Тогда
			Продолжить;
		КонецЕсли;

		Запись = Движения.БольничныеПериоды.Добавить();
		Запись.Период           = СтрокаБольничного.С;
		Запись.Сотрудник        = СтрокаБольничного.Сотрудник;
		Запись.НомерБольничного = СтрокаБольничного.НомерБольничного;
		Запись.ДатаОкончания    = СтрокаБольничного.По;

	КонецЦикла;

КонецПроцедуры
