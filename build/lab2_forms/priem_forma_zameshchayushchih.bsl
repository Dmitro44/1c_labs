#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Последние известные места работы сотрудников (подразделение/должность)
	// берутся из регистра учета сотрудников.
	МестаРаботы = Новый Соответствие;
	ЗапросУчета = Новый Запрос;
	ЗапросУчета.Текст =
	"ВЫБРАТЬ
	|	Учет.Сотрудник КАК Сотрудник,
	|	Учет.Подразделение КАК Подразделение,
	|	Учет.Должность КАК Должность
	|ИЗ
	|	РегистрСведений.РегистрУчетаСотрудников КАК Учет
	|УПОРЯДОЧИТЬ ПО
	|	Период УБЫВ";
	ВыборкаУчета = ЗапросУчета.Выполнить().Выбрать();
	Пока ВыборкаУчета.Следующий() Цикл
		Если МестаРаботы[ВыборкаУчета.Сотрудник] = Неопределено Тогда
			МестаРаботы.Вставить(ВыборкаУчета.Сотрудник,
				Новый Структура("Подразделение, Должность",
					ВыборкаУчета.Подразделение, ВыборкаУчета.Должность));
		КонецЕсли;
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Отсутствия.Сотрудник КАК Сотрудник,
	|	Отсутствия.ПричинаОтсутствия КАК ПричинаОтсутствия,
	|	Отсутствия.ДатаНачала КАК ДатаНачала,
	|	Отсутствия.ДатаОкончания КАК ДатаОкончания
	|ИЗ
	|	РегистрСведений.РегистрУчетаОтсутствияСотрудников КАК Отсутствия
	|УПОРЯДОЧИТЬ ПО
	|	Сотрудник";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаОтсутствия = Отсутствующие.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаОтсутствия, Выборка);
		МестоРаботы = МестаРаботы[Выборка.Сотрудник];
		Если МестоРаботы <> Неопределено Тогда
			СтрокаОтсутствия.Подразделение = МестоРаботы.Подразделение;
			СтрокаОтсутствия.Должность = МестоРаботы.Должность;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Выбрать(Команда)
	ВыделенныеСтроки = Элементы.Отсутствующие.ВыделенныеСтроки;
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Не выбран ни один сотрудник.");
		Возврат;
	КонецЕсли;
	СтрокаВыбора = Отсутствующие[ВыделенныеСтроки[0]];
	РезультатВыбора = Новый Структура(
		"Сотрудник, Подразделение, Должность, ПричинаОтсутствия",
		СтрокаВыбора.Сотрудник,
		СтрокаВыбора.Подразделение,
		СтрокаВыбора.Должность,
		СтрокаВыбора.ПричинаОтсутствия);
	ОповеститьОВыборе(РезультатВыбора);
	Закрыть();
КонецПроцедуры

#КонецОбласти
