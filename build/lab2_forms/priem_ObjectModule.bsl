Процедура ПриУстановкеНовогоНомера(СтандартнаяОбработка)
КонецПроцедуры

// Формирует движения по семи регистрам:
//  - КомплектованияСотрудников
//  - ПериодОтпуска (рабочий год, за который положен отпуск)
//  - РегистрУчетаСотрудников
//  - РегистрУчетаОтсутствияСотрудников (при приеме методом замещения)
//  - РегистрУчетаЗамещенияСотрудников (при приеме методом замещения)
//  - РегистрУчетаСовмещений (при виде работы «Совмещение» или доплате за совмещение)
//  - РегистрНакопленияНадбавок (по табличной части надбавок)
Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Движения.КомплектованияСотрудников.Записывать = Истина;
	Движения.ПериодОтпуска.Записывать = Истина;
	Движения.РегистрУчетаСотрудников.Записывать = Истина;
	Движения.РегистрУчетаОтсутствияСотрудников.Записывать = Истина;
	Движения.РегистрУчетаЗамещенияСотрудников.Записывать = Истина;
	Движения.РегистрУчетаСовмещений.Записывать = Истина;
	Движения.РегистрНакопленияНадбавок.Записывать = Истина;

	ЭтоЗамещение = (МетодПриема = "Замещение") И ЗначениеЗаполнено(ОтсутствующийСотрудник);

	// 1. Комплектования сотрудников
	Запись = Движения.КомплектованияСотрудников.Добавить();
	Запись.Период = Дата;
	Запись.Сотрудник             = Сотрудник;
	Запись.ВидКомплектования     = ВидКомплектования;
	Запись.НовыйВидКомплектования = НовыйВидКомплектования;
	Запись.ДатаПриема            = ДатаПриема;
	Запись.ДатаУвольнения        = ДатаУвольнения;
	Запись.КоличествоЛет         = КоличествоЛет;

	// 2. Период отпуска: рабочий год, за который предоставляется отпуск.
	//    Если срок работы не ограничен датой увольнения — один год с даты приема.
	Запись = Движения.ПериодОтпуска.Добавить();
	Запись.Сотрудник   = Сотрудник;
	Запись.ДатаНачала  = ДатаПриема;
	Если ЗначениеЗаполнено(ДатаУвольнения) Тогда
		Запись.ДатаОкончания = ДатаУвольнения;
	ИначеЕсли КоличествоЛет > 0 Тогда
		Запись.ДатаОкончания = ДобавитьМесяц(ДатаПриема, 12 * КоличествоЛет) - 1;
	Иначе
		Запись.ДатаОкончания = ДобавитьМесяц(ДатаПриема, 12) - 1;
	КонецЕсли;

	// 3. Учет сотрудников
	Запись = Движения.РегистрУчетаСотрудников.Добавить();
	Запись.Период = Дата;
	Запись.Сотрудник         = Сотрудник;
	Запись.Подразделение     = Подразделение;
	Запись.Должность         = Должность;
	Запись.ВидФинансирования = ВидФинансирования;
	Запись.ВидРаботы         = ВидРаботы;
	Запись.Ставка            = Ставка;
	Запись.Оклад             = Оклад;
	Запись.Статус            = Перечисления.СтатусСотрудника.Работает;
	Запись.ДатаПриема        = ДатаПриема;
	Запись.ДатаУвольнения    = ДатаУвольнения;

	Если ЭтоЗамещение Тогда

		// 4. Учет отсутствия заменяемого сотрудника
		Запись = Движения.РегистрУчетаОтсутствияСотрудников.Добавить();
		Запись.Период = Дата;
		Запись.Сотрудник         = ОтсутствующийСотрудник;
		Запись.ПричинаОтсутствия = ПричинаОтсутствия;
		Запись.ДатаНачала        = ДатаПриема;
		Запись.ДатаОкончания     = ?(ЗначениеЗаполнено(ДатаОкончанияДоплатыЗаСовмещение),
			ДатаОкончанияДоплатыЗаСовмещение, ДатаУвольнения);

		// 5. Учет замещения
		Запись = Движения.РегистрУчетаЗамещенияСотрудников.Добавить();
		Запись.Период = Дата;
		Запись.Сотрудник           = Сотрудник;
		Запись.ЗамещаемыйСотрудник = ОтсутствующийСотрудник;
		Запись.Подразделение       = ПодразделениеОтсутствующего;
		Запись.Должность           = ДолжностьОтсутствующего;
		Запись.ВидФинансирования   = ВидФинансированияОтсутствующего;
		Запись.ДатаНачала          = ДатаПриема;
		Запись.ДатаОкончания       = ?(ЗначениеЗаполнено(ДатаОкончанияДоплатыЗаСовмещение),
			ДатаОкончанияДоплатыЗаСовмещение, ДатаУвольнения);

	КонецЕсли;

	// 6. Учет совмещений
	Если ВидРаботы = Перечисления.ВидРаботы.Совмещение
		Или ЗначениеЗаполнено(ВидДоплатыЗаСовмещение) Тогда
		Запись = Движения.РегистрУчетаСовмещений.Добавить();
		Запись.Период = Дата;
		Запись.Сотрудник             = Сотрудник;
		Запись.ВидДоплатыЗаСовмещение = ВидДоплатыЗаСовмещение;
		Запись.ВидРаботы             = ВидРаботы;
		Запись.Ставка                = Ставка;
		Запись.ДатаНачала            = ДатаПриема;
		Запись.ДатаОкончания         = ?(ЗначениеЗаполнено(ДатаОкончанияДоплатыЗаСовмещение),
			ДатаОкончанияДоплатыЗаСовмещение, ДатаУвольнения);
	КонецЕсли;

	// 7. Надбавки
	Для Каждого СтрокаНадбавки Из Надбавки Цикл
		Если Не ЗначениеЗаполнено(СтрокаНадбавки.Надбавка) Тогда
			Продолжить;
		КонецЕсли;
		Запись = Движения.РегистрНакопленияНадбавок.Добавить();
		Запись.Период      = Дата;
		Запись.Сотрудник   = Сотрудник;
		Запись.Надбавка    = СтрокаНадбавки.Надбавка;
		Запись.ЕдИзм       = СтрокаНадбавки.ЕдИзм;
		Запись.Размер      = СтрокаНадбавки.Размер;
		Запись.ДатаНачала  = СтрокаНадбавки.Начало;
		Запись.ДатаОкончания = СтрокаНадбавки.Конец;
	КонецЦикла;

КонецПроцедуры
