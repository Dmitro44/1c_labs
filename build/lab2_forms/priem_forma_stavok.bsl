#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗаполнитьСтавки();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заполняет таблицу остатками ставок по подразделению и должности.
&НаСервере
Процедура ЗаполнитьСтавки()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Подразделение КАК Подразделение,
	|	Остатки.Должность КАК Должность,
	|	Остатки.ВидФинансирования КАК ВидФинансирования,
	|	Остатки.Разряд КАК Разряд,
	|	СУММА(Остатки.Ставка) КАК Ставка,
	|	СУММА(Остатки.Оклад) КАК Оклад
	|ИЗ
	|	РегистрСведений.РегистрРаботыСоШтатнымРасписанием КАК Остатки
	|ГДЕ
	|	Остатки.Подразделение = &Подразделение
	|	И Остатки.Должность = &Должность
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Подразделение,
	|	Остатки.Должность,
	|	Остатки.ВидФинансирования,
	|	Остатки.Разряд
	|ИМЕЮЩИЕ
	|	СУММА(Остатки.Ставка) > 0";

	Запрос.УстановитьПараметр("Подразделение", Параметры.Подразделение);
	Запрос.УстановитьПараметр("Должность", Параметры.Должность);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаСтавки = Ставки.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаСтавки, Выборка);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
