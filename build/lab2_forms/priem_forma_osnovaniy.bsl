#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Выборка = Справочники.ПричинаОтсутствия.Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаОснования = Основания.Добавить();
		СтрокаОснования.Основание = Выборка.Ссылка;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Выбрать(Команда)

	ВыбранныеОснования = Новый Массив;
	Для Каждого СтрокаОснования Из Основания Цикл
		Если СтрокаОснования.Выбрано Тогда
			ВыбранныеОснования.Добавить(СтрокаОснования.Основание);
		КонецЕсли;
	КонецЦикла;

	Если ВыбранныеОснования.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Не выбрано основание.");
		Возврат;
	КонецЕсли;

	Если ВыбранныеОснования.Количество() > 1 Тогда
		ПоказатьПредупреждение(, "Выберите только одно основание.");
		Возврат;
	КонецЕсли;

	// После ОповеститьОВыборе платформа закрывает форму сама.
	ОповеститьОВыборе(ВыбранныеОснования[0]);

КонецПроцедуры

#КонецОбласти
