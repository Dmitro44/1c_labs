#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗаполнитьСписокШтатныхЕдиниц();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ОбновитьСписокПриИзменении(Элемент)
	ЗаполнитьСписокШтатныхЕдиниц();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Выбрать(Команда)
	ВыбранныеСтроки = Новый Массив;
	Для Каждого Строка Из ШтатныеЕдиницы Цикл
		Если Строка.Пометка Тогда
			ВыбранныеСтроки.Добавить(Новый Структура(
				"Финансирование, Подразделение, Должность, Разряд, Ставка, Оклад",
				Строка.Финансирование, Строка.Подразделение, Строка.Должность,
				Строка.Разряд, Строка.Ставка, Строка.Оклад));
		КонецЕсли;
	КонецЦикла;
	Если ВыбранныеСтроки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Не выбрано ни одной штатной единицы.");
		Возврат;
	КонецЕсли;
	ОповеститьОВыборе(ВыбранныеСтроки);
	Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписок(Команда)
	ЗаполнитьСписокШтатныхЕдиниц();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заполняет таблицу доступными штатными единицами по остаткам
// регистра «Регистр работы со штатным расписанием» с учетом отбора.
&НаСервере
Процедура ЗаполнитьСписокШтатныхЕдиниц()

	ШтатныеЕдиницы.Очистить();

	// Фильтры применяются только к заполненным полям отбора.
	УсловияОтбора = Новый Массив;
	Если ЗначениеЗаполнено(ОтборПодразделение) Тогда
		УсловияОтбора.Добавить("Остатки.Подразделение = &Подразделение");
	КонецЕсли;
	Если ЗначениеЗаполнено(ОтборДолжность) Тогда
		УсловияОтбора.Добавить("Остатки.Должность = &Должность");
	КонецЕсли;
	Если ЗначениеЗаполнено(ОтборФинансирование) Тогда
		УсловияОтбора.Добавить("Остатки.ВидФинансирования = &Финансирование");
	КонецЕсли;

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Остатки.Подразделение КАК Подразделение,
	|	Остатки.Должность КАК Должность,
	|	Остатки.ВидФинансирования КАК Финансирование,
	|	Остатки.Разряд КАК Разряд,
	|	СУММА(Остатки.Ставка) КАК Ставка,
	|	СУММА(Остатки.Оклад) КАК Оклад
	|ИЗ
	|	РегистрСведений.РегистрРаботыСоШтатнымРасписанием КАК Остатки";

	Если УсловияОтбора.Количество() > 0 Тогда
		ТекстЗапроса = ТекстЗапроса + СтрШаблон("
	|ГДЕ
	|	%1", СтрСоединить(УсловияОтбора, "
	|	И "));
	КонецЕсли;

	ТекстЗапроса = ТекстЗапроса + "
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Подразделение,
	|	Остатки.Должность,
	|	Остатки.ВидФинансирования,
	|	Остатки.Разряд
	|ИМЕЮЩИЕ
	|	СУММА(Остатки.Ставка) > 0";

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Подразделение", ОтборПодразделение);
	Запрос.УстановитьПараметр("Должность", ОтборДолжность);
	Запрос.УстановитьПараметр("Финансирование", ОтборФинансирование);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = ШтатныеЕдиницы.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Выборка);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
