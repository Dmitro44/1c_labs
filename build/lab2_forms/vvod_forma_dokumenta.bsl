#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Загрузить(Команда)
	ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
	ПараметрыДиалога.Заголовок = "Выберите файл Excel";
	ПараметрыДиалога.Фильтр = "Excel (*.xlsx, *.xls)|*.xlsx;*.xls|Все файлы (*.*)|*.*";
	ПараметрыДиалога.МножественныйВыбор = Ложь;
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗагрузкаФайлаЗавершение", ЭтотОбъект);
	НачатьПомещениеФайлаНаСервер(ОписаниеОповещения, , , , ПараметрыДиалога, УникальныйИдентификатор);
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузкаФайлаЗавершение(ОписаниеПомещенногоФайла, ДопПараметры) Экспорт
	Если ОписаниеПомещенногоФайла = Неопределено Тогда
		Возврат;
	КонецЕсли;
	РезультатЗагрузки = ЗагрузитьИзExcelНаСервере(ОписаниеПомещенногоФайла.Адрес);

	Если РезультатЗагрузки.КоличествоСтрок > 0 Тогда
		ТекстСообщения = СтрШаблон("Загружено штатных единиц: %1", РезультатЗагрузки.КоличествоСтрок);
		Если Не ПустаяСтрока(РезультатЗагрузки.НомерДокумента) Тогда
			ТекстСообщения = ТекстСообщения + Символы.ПС
				+ СтрШаблон("Номер документа: %1", РезультатЗагрузки.НомерДокумента);
		КонецЕсли;
		Если Не ПустаяСтрока(РезультатЗагрузки.Предупреждение) Тогда
			ТекстСообщения = ТекстСообщения + Символы.ПС + РезультатЗагрузки.Предупреждение;
		КонецЕсли;
	Иначе
		ТекстСообщения = "Не загружено ни одной строки.";
	КонецЕсли;

	Если РезультатЗагрузки.Ошибки.Количество() > 0 Тогда
		ТекстСообщения = ТекстСообщения + Символы.ПС + Символы.ПС
			+ СтрШаблон("Не загружены строки с ошибками (%1):", РезультатЗагрузки.Ошибки.Количество());
		Выведено = 0;
		Для Каждого ОписаниеОшибки Из РезультатЗагрузки.Ошибки Цикл
			Если Выведено = 10 Тогда
				ТекстСообщения = ТекстСообщения + Символы.ПС
					+ СтрШаблон("... и ещё %1", РезультатЗагрузки.Ошибки.Количество() - Выведено);
				Прервать;
			КонецЕсли;
			ТекстСообщения = ТекстСообщения + Символы.ПС + ОписаниеОшибки;
			Выведено = Выведено + 1;
		КонецЦикла;
	КонецЕсли;

	ПоказатьПредупреждение(, ТекстСообщения);
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьТаблицу(Команда)
	Объект.ШтатныеЕдиницы.Очистить();
	ПересчитатьИтоги();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПересчитатьИтоги()
	Объект.ИтогоОклад = 0;
	Объект.ИтогоСтавок = 0;
	Для Каждого Строка Из Объект.ШтатныеЕдиницы Цикл
		Объект.ИтогоОклад = Объект.ИтогоОклад + Строка.Оклад;
		Объект.ИтогоСтавок = Объект.ИтогоСтавок + Строка.Ставка;
	КонецЦикла;
КонецПроцедуры

// Загружает штатные единицы из файла Excel по адресу во временном хранилище.
// Ожидаемые колонки: Номер документа, Подразделение, Должность, Финансирование,
// Разряд, Ставка, Оклад.
// Строки с ошибками не загружаются, а возвращаются в списке Ошибки с указанием причины.
//
// Возвращаемое значение:
//  Структура - КоличествоСтрок, Ошибки (Массив строк), НомерДокумента.
&НаСервере
Функция ЗагрузитьИзExcelНаСервере(Адрес)
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(Адрес);
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xlsx");
	ДвоичныеДанные.Записать(ИмяВременногоФайла);

	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.Прочитать(ИмяВременногоФайла, СпособЧтенияЗначенийТабличногоДокумента.Значение);
	УдалитьФайлы(ИмяВременногоФайла);

	Объект.ШтатныеЕдиницы.Очистить();

	Результат = Новый Структура("КоличествоСтрок, Ошибки, НомерДокумента, Предупреждение",
		0, Новый Массив, "", "");

	// Метод Прочитать помещает все листы книги в один табличный документ
	// (последовательно по вертикали), поэтому ограничиваемся листом "Импорт".
	НачалоСтрок = 1;
	КонецСтрок = ТабличныйДокумент.ВысотаТаблицы;
	Попытка
		Для Каждого ОбластьЛиста Из ТабличныйДокумент.Области Цикл
			Если ВРег(СокрЛП(ОбластьЛиста.Имя)) = "ИМПОРТ" Тогда
				НачалоСтрок = ОбластьЛиста.Верх;
				КонецСтрок = ОбластьЛиста.Низ;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	Исключение
		НачалоСтрок = 1;
		КонецСтрок = ТабличныйДокумент.ВысотаТаблицы;
	КонецПопытки;

	Для НомерСтроки = НачалоСтрок По КонецСтрок Цикл

		НомерДокумента = ТекстИзЯчейки(ТабличныйДокумент.Область(НомерСтроки, 1));
		ПредставлениеПодразделения = ТекстИзЯчейки(ТабличныйДокумент.Область(НомерСтроки, 2));
		Если ПустаяСтрока(ПредставлениеПодразделения) Тогда
			Продолжить;
		КонецЕсли;
		Если ВРег(ПредставлениеПодразделения) = "ПОДРАЗДЕЛЕНИЕ" Тогда
			Продолжить; // строка заголовков
		КонецЕсли;

		ПредставлениеДолжности = ТекстИзЯчейки(ТабличныйДокумент.Область(НомерСтроки, 3));
		ПредставлениеФинансирования = ТекстИзЯчейки(ТабличныйДокумент.Область(НомерСтроки, 4));

		Подразделение = Справочники.Подразделения.НайтиПоНаименованию(ПредставлениеПодразделения, Истина);
		Должность = Справочники.Должности.НайтиПоНаименованию(ПредставлениеДолжности, Истина);
		ВидФинансирования = ВидФинансированияПоНаименованию(ПредставлениеФинансирования);

		ОшибкиСтроки = Новый Массив;
		Если Подразделение = Неопределено Тогда
			ОшибкиСтроки.Добавить(СтрШаблон("подразделение ""%1"" не найдено", ПредставлениеПодразделения));
		КонецЕсли;
		Если Должность = Неопределено Тогда
			ОшибкиСтроки.Добавить(СтрШаблон("должность ""%1"" не найдено", ПредставлениеДолжности));
		КонецЕсли;
		Если ВидФинансирования = Неопределено Тогда
			ОшибкиСтроки.Добавить(СтрШаблон("финансирование ""%1"" не найдено", ПредставлениеФинансирования));
		КонецЕсли;

		Разряд = ЧислоИзЯчейки(ТабличныйДокумент.Область(НомерСтроки, 5), "Разряд", ОшибкиСтроки);
		Ставка = ЧислоИзЯчейки(ТабличныйДокумент.Область(НомерСтроки, 6), "Ставка", ОшибкиСтроки);
		Оклад = ЧислоИзЯчейки(ТабличныйДокумент.Область(НомерСтроки, 7), "Оклад", ОшибкиСтроки);

		Если ОшибкиСтроки.Количество() > 0 Тогда
			// Строку, в которой не нашлось ни подразделения, ни должности, считаем "не нашей"
			// (например, данные другого листа книги) и пропускаем молча.
			Если Не (Подразделение = Неопределено И Должность = Неопределено) Тогда
				Результат.Ошибки.Добавить(СтрШаблон("Строка %1: %2", НомерСтроки,
					СтрСоединить(ОшибкиСтроки, "; ")));
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Строка = Объект.ШтатныеЕдиницы.Добавить();
		Строка.Подразделение = Подразделение;
		Строка.Должность = Должность;
		Строка.ВидФинансирования = ВидФинансирования;
		Строка.Разряд = Разряд;
		Строка.Ставка = Ставка;
		Строка.Оклад = Оклад;

		Результат.КоличествоСтрок = Результат.КоличествоСтрок + 1;
		Если ПустаяСтрока(Результат.НомерДокумента) И Не ПустаяСтрока(НомерДокумента) Тогда
			Результат.НомерДокумента = НомерДокумента;
		КонецЕсли;

	КонецЦикла;

	// Страховка: в табличной части не должно остаться строк без подразделения и должности.
	Индекс = Объект.ШтатныеЕдиницы.Количество() - 1;
	Пока Индекс >= 0 Цикл
		СтрокаТЧ = Объект.ШтатныеЕдиницы[Индекс];
		Если Не ЗначениеЗаполнено(СтрокаТЧ.Подразделение)
			И Не ЗначениеЗаполнено(СтрокаТЧ.Должность) Тогда
			Объект.ШтатныеЕдиницы.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;

	// Если в файле указан номер документа, проставляем его в реквизит "Номер".
	// Если такой номер уже есть в базе, оставляем автонумерацию, чтобы не нарушать уникальность.
	Если Не ПустаяСтрока(Результат.НомерДокумента) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка
		|ИЗ Документ.ВводШтатнойЕдиницы
		|ГДЕ Номер = &Номер И НЕ ПометкаУдаления";
		Запрос.УстановитьПараметр("Номер", Результат.НомерДокумента);
		Если Запрос.Выполнить().Пустой() Тогда
			Объект.Номер = Результат.НомерДокумента;
		Иначе
			Результат.Предупреждение = СтрШаблон(
				"Номер документа %1 уже используется — оставлена автонумерация.",
				Результат.НомерДокумента);
			Результат.НомерДокумента = "";
		КонецЕсли;
	КонецЕсли;

	ПересчитатьИтоги();
	Возврат Результат;
КонецФункции

&НаСервере
Функция ВидФинансированияПоНаименованию(Представление)
	ТекстДляСравнения = ВРег(СокрЛП(Представление));
	Для Каждого ЗначениеМетаданных Из
		Метаданные.Перечисления.ИсточникФинансирования.ЗначенияПеречисления Цикл
		Значение = Перечисления.ИсточникФинансирования[ЗначениеМетаданных.Имя];
		Если ВРег(СокрЛП(Строка(Значение))) = ТекстДляСравнения Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

&НаСервере
Функция ТекстИзЯчейки(Ячейка)
	Попытка
		Возврат СокрЛП(Ячейка.Текст);
	Исключение
		Попытка
			Возврат СокрЛП(Строка(Ячейка.Значение));
		Исключение
			Возврат "";
		КонецПопытки;
	КонецПопытки;
КонецФункции

&НаСервере
Функция ЧислоИзЯчейки(Ячейка, ИмяКолонки, ОшибкиСтроки)
	Если Ячейка.СодержитЗначение И ТипЗнч(Ячейка.Значение) = Тип("Число") Тогда
		Возврат Ячейка.Значение;
	КонецЕсли;
	Текст = ТекстИзЯчейки(Ячейка);
	Если ПустаяСтрока(Текст) Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Возврат Число(Текст);
	Исключение
		ОшибкиСтроки.Добавить(СтрШаблон("""%1"" в колонке ""%2"" не является числом",
			Текст, ИмяКолонки));
		Возврат 0;
	КонецПопытки;
КонецФункции

#КонецОбласти
