#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	ПересчитатьИтоги();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ПересчитатьИтогиПриИзменении(Элемент)
	ПересчитатьИтоги();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Загрузить(Команда)
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗагрузкаФайлаЗавершение", ЭтотОбъект);
	НачатьПомещениеФайлаНаСервер(
		ОписаниеОповещения,
		,
		"*.xlsx|*.xls|Все файлы (*.*)|*.*",
		,
		УникальныйИдентификатор);
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузкаФайлаЗавершение(Результат, Адрес, ВыбранноеИмяФайла, ДопПараметры) Экспорт
	Если Не Результат Тогда
		Возврат;
	КонецЕсли;
	КоличествоСтрок = ЗагрузитьИзExcelНаСервере(Адрес);
	Если КоличествоСтрок > 0 Тогда
		ПоказатьПредупреждение(, СтрШаблон("Загружено штатных единиц: %1", КоличествоСтрок));
	Иначе
		ПоказатьПредупреждение(, "В файле не найдено ни одной подходящей строки.");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьТаблицу(Команда)
	Объект.ШтатныеЕдиницы.Очистить();
	ПересчитатьИтоги();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПересчитатьИтоги()
	Объект.ИтогоОклад = 0;
	Объект.ИтогоСтавок = 0;
	Для Каждого Строка Из Объект.ШтатныеЕдиницы Цикл
		Объект.ИтогоОклад = Объект.ИтогоОклад + Строка.Оклад;
		Объект.ИтогоСтавок = Объект.ИтогоСтавок + Строка.Ставка;
	КонецЦикла;
КонецПроцедуры

// Загружает штатные единицы из файла Excel по адресу во временном хранилище.
// Ожидаемые колонки: Подразделение, Должность, Финансирование, Разряд, Ставка, Оклад.
//
// Возвращаемое значение:
//  Число - количество загруженных строк.
&НаСервере
Функция ЗагрузитьИзExcelНаСервере(Адрес)
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(Адрес);
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xlsx");
	ДвоичныеДанные.Записать(ИмяВременногоФайла);

	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.Прочитать(ИмяВременногоФайла, СпособЧтенияЗначенийТабличногоДокумента.Значение);
	УдалитьФайлы(ИмяВременногоФайла);

	Объект.ШтатныеЕдиницы.Очистить();

	Для НомерСтроки = 1 По ТабличныйДокумент.ВысотаТаблицы Цикл

		ПредставлениеПодразделения = СокрЛП(ТабличныйДокумент.Область(НомерСтроки, 1).Текст);
		Если ПустаяСтрока(ПредставлениеПодразделения) Тогда
			Продолжить;
		КонецЕсли;
		Если НомерСтроки = 1 И ПредставлениеПодразделения = "Подразделение" Тогда
			Продолжить; // пропуск строки заголовков
		КонецЕсли;

		Строка = Объект.ШтатныеЕдиницы.Добавить();
		Строка.Подразделение = Справочники.Подразделения.НайтиПоНаименованию(ПредставлениеПодразделения, Истина);
		Строка.Должность = Справочники.Должности.НайтиПоНаименованию(
			СокрЛП(ТабличныйДокумент.Область(НомерСтроки, 2).Текст), Истина);
		Строка.ВидФинансирования = ЗначениеПеречисленияПоПредставлению(
			Перечисления.ИсточникФинансирования,
			СокрЛП(ТабличныйДокумент.Область(НомерСтроки, 3).Текст));
		Строка.Разряд = ЧислоИзЯчейки(ТабличныйДокумент.Область(НомерСтроки, 4));
		Строка.Ставка = ЧислоИзЯчейки(ТабличныйДокумент.Область(НомерСтроки, 5));
		Строка.Оклад = ЧислоИзЯчейки(ТабличныйДокумент.Область(НомерСтроки, 6));

	КонецЦикла;

	ПересчитатьИтоги();
	Возврат Объект.ШтатныеЕдиницы.Количество();
КонецФункции

&НаСервере
Функция ЧислоИзЯчейки(Ячейка)
	Если ТипЗнч(Ячейка.Значение) = Тип("Число") Тогда
		Возврат Ячейка.Значение;
	КонецЕсли;
	Текст = СокрЛП(Ячейка.Текст);
	Если ПустаяСтрока(Текст) Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Число(Текст);
КонецФункции

&НаСервере
Функция ЗначениеПеречисленияПоПредставлению(Перечисление, Представление)
	Если Не ПустаяСтрока(Представление) Тогда
		Для Каждого Значение Из Перечисление Цикл
			Если ВРег(СтрЗаменить(Значение.Представление(), " ", ""))
				= ВРег(СтрЗаменить(Представление, " ", "")) Тогда
				Возврат Значение;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

#КонецОбласти
