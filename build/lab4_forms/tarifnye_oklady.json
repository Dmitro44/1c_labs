  ],
  "commands": [
    { "name": "Сформировать", "title": "Сформировать…", "action": "Сформировать" },
    { "name": "ВыбратьВариант", "title": "Выбрать вариант…", "action": "ВыбратьВариант" },
    { "name": "Настройки", "title": "Настройки…", "action": "Настройки" }
  ]
}
