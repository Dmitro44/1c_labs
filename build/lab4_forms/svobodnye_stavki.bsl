#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Дата = ТекущаяДатаСеанса();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сформировать(Команда)
	СформироватьНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СформироватьНаСервере()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ШР.Подразделения КАК Подразделение,
	|	ШР.Должности КАК Должность,
	|	ШР.ВидФинансирования КАК ВидФинансирования,
	|	ШР.СтавкаОстаток КАК СтавкиВШтатном,
	|	ЕСТЬNULL(Сотрудники.СтавкаОстаток, 0) КАК ЗанятыеСтавки
	|ИЗ
	|	РегистрНакопления.РегистрРаботыСоШтатнымРасписанием.Остатки(
	|		&Дата,
	|		Подразделения В (&Подразделения) И Должности В (&Должности)
	|			И ВидФинансирования В (&ВидыФин)) КАК ШР
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РегистрУчетаСотрудников.Остатки(&Дата, ) КАК Сотрудники
	|		ПО ШР.Подразделения = Сотрудники.Подразделения
	|			И ШР.Должности = Сотрудники.Должности
	|			И ШР.ВидФинансирования = Сотрудники.ВидФинансирования
	|
	|УПОРЯДОЧИТЬ ПО
	|	Подразделение,
	|	Должность";
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Подразделения", Подразделения);
	Запрос.УстановитьПараметр("Должности", Должности);
	Запрос.УстановитьПараметр("ВидыФин", ВидыФинансирования);

	Выборка = Запрос.Выполнить().Выбрать();

	Результат.Очистить();
	Результат.ФиксацияСлева = 1;

	Результат.Область(1, 1, 1, 6).Объединение();
	Результат.Область(1, 1, 1, 6).Текст = "Свободные ставки на " + Формат(Дата, "ДФ=dd.MM.yyyy");

	Результат.Область(2, 1, 2, 1).Текст = "Подразделение";
	Результат.Область(2, 2, 2, 2).Текст = "Должность";
	Результат.Область(2, 3, 2, 3).Текст = "Вид финансирования";
	Результат.Область(2, 4, 2, 4).Текст = "Ставки в штатном расписании";
	Результат.Область(2, 5, 2, 5).Текст = "Занятые ставки";
	Результат.Область(2, 6, 2, 6).Текст = "Свободные ставки";

	Строка = 3;
	Пока Выборка.Следующий() Цикл
		Свободные = Выборка.СтавкиВШтатном - Выборка.ЗанятыеСтавки;
		Результат.Область(Строка, 1, Строка, 1).Текст = Строка(Выборка.Подразделение);
		Результат.Область(Строка, 2, Строка, 2).Текст = Строка(Выборка.Должность);
		Результат.Область(Строка, 3, Строка, 3).Текст = Строка(Выборка.ВидФинансирования);
		Результат.Область(Строка, 4, Строка, 4).Текст = Формат(Выборка.СтавкиВШтатном, "ЧДЦ=2");
		Результат.Область(Строка, 5, Строка, 5).Текст = Формат(Выборка.ЗанятыеСтавки, "ЧДЦ=2");
		Результат.Область(Строка, 6, Строка, 6).Текст = ?(Свободные > 0, Формат(Свободные, "ЧДЦ=2"), "");
		Строка = Строка + 1;
	КонецЦикла;

	Результат.Область(1, 1, Строка - 1, 6).СодержитТолькоПросмотр = Истина;
	Результат.ПоказыватьСетку = Ложь;

КонецПроцедуры

#КонецОбласти
