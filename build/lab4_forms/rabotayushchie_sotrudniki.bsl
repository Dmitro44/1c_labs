#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ДатаНачала = НачалоМесяца(ТекущаяДатаСеанса());
	ДатаОкончания = КонецМесяца(ТекущаяДатаСеанса());
	ВидОтображения = "Списком";
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сформировать(Команда)
	СформироватьНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СформироватьНаСервере()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Рег.Сотрудники КАК Сотрудник,
	|	Рег.Подразделения КАК Подразделение,
	|	Рег.Должности КАК Должность,
	|	Рег.ВидФинансирования КАК ВидФинансирования,
	|	Рег.ВидыРаботы КАК ВидРаботы,
	|	Сотрудник.Наименование КАК ФИО,
	|	Сотрудник.ДатаРождения КАК ДатаРождения
	|ИЗ
	|	РегистрНакопления.РегистрУчетаСотрудников.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, Запись, , ) КАК Рег
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Сотрудники КАК Сотрудник
	|		ПО Рег.Сотрудники = Сотрудник.Ссылка
	|ГДЕ
	|	(Рег.СтавкаНачальныйОстаток > 0 ИЛИ Рег.СтавкаПриход > 0)
	|	И (&ВидыРаботыПусто ИЛИ Рег.ВидыРаботы В (&ВидыРаботы))
	|	И (&ВидыФинПусто ИЛИ Рег.ВидФинансирования В (&ВидыФин))
	|	И (&ПодразделенияПусто ИЛИ Рег.Подразделения В (&Подразделения))
	|	И (&ДолжностиПусто ИЛИ Рег.Должности В (&Должности))
	|	И (НЕ &ИспользоватьПол ИЛИ Сотрудник.Пол = &Пол)
	|	И (НЕ &ИспользоватьДоговор ИЛИ Сотрудник.ВидКомплектования = &ВидДоговора)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ФИО";
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ДатаОкончания));
	Запрос.УстановитьПараметр("ВидыРаботы", ВидыРаботы);
	Запрос.УстановитьПараметр("ВидыРаботыПусто", ВидыРаботы.Количество() = 0);
	Запрос.УстановитьПараметр("ВидыФин", ВидыФинансирования);
	Запрос.УстановитьПараметр("ВидыФинПусто", ВидыФинансирования.Количество() = 0);
	Запрос.УстановитьПараметр("Подразделения", Подразделения);
	Запрос.УстановитьПараметр("ПодразделенияПусто", Подразделения.Количество() = 0);
	Запрос.УстановитьПараметр("Должности", Должности);
	Запрос.УстановитьПараметр("ДолжностиПусто", Должности.Количество() = 0);
	Запрос.УстановитьПараметр("ИспользоватьПол", ЗначениеЗаполнено(Пол));
	Запрос.УстановитьПараметр("Пол", Пол);
	Запрос.УстановитьПараметр("ИспользоватьДоговор", ЗначениеЗаполнено(ВидДоговора));
	Запрос.УстановитьПараметр("ВидДоговора", ВидДоговора);

	Результат.Очистить();
	Результат.ФиксацияСлева = 1;

	Результат.Область(1, 1, 1, 5).Объединение();
	Результат.Область(1, 1, 1, 5).Текст =
		"Список сотрудников, работавших в течении периода с "
		+ Формат(ДатаНачала, "ДФ=dd.MM.yyyy") + " по " + Формат(ДатаОкончания, "ДФ=dd.MM.yyyy");

	Результат.Область(2, 1, 2, 1).Текст = "№";
	Результат.Область(2, 2, 2, 2).Текст = "Ф.И.О.";
	Результат.Область(2, 3, 2, 3).Текст = "Должность";
	Результат.Область(2, 4, 2, 4).Текст = "Ставка";
	Результат.Область(2, 5, 2, 5).Текст = "Дата рождения";

	Строка = 3;
	Номер = 1;
	ТекущаяГруппа = "";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Если ВидОтображения = "По подразделениям" ИЛИ ВидОтображения = "По виду персонала" Тогда
			Группа = ?(ВидОтображения = "По подразделениям",
				Строка(Выборка.Подразделение), Строка(Выборка.ВидФинансирования));
			Если Группа <> ТекущаяГруппа Тогда
				ТекущаяГруппа = Группа;
				Результат.Область(Строка, 1, Строка, 5).Объединение();
				Результат.Область(Строка, 1, Строка, 5).Текст = Группа;
				Строка = Строка + 1;
				Номер = 1;
			КонецЕсли;
		КонецЕсли;

		Результат.Область(Строка, 1, Строка, 1).Текст = Номер;
		Результат.Область(Строка, 2, Строка, 2).Текст = Выборка.ФИО;
		Результат.Область(Строка, 3, Строка, 3).Текст = Строка(Выборка.Должность);
		Результат.Область(Строка, 4, Строка, 4).Текст = "";
		Результат.Область(Строка, 5, Строка, 5).Текст = Формат(Выборка.ДатаРождения, "ДЛФ=D");
		Строка = Строка + 1;
		Номер = Номер + 1;

	КонецЦикла;

	Результат.Область(1, 1, Строка - 1, 5).СодержитТолькоПросмотр = Истина;
	Результат.ПоказыватьСетку = Ложь;

КонецПроцедуры

#КонецОбласти
