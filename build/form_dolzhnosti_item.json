{
  "title": "Должность",
  "properties": { "autoTitle": true },
  "elements": [
    { "group": "vertical", "name": "ГруппаШапка", "children": [
      { "input": "Код", "path": "Объект.Code", "width": 12 },
      { "input": "Наименование", "path": "Объект.Description" },
      { "input": "Родитель", "path": "Объект.Parent", "title": "Входит в группу" },
      { "input": "Имя", "path": "Объект.Имя", "visible": false }
    ]},
    { "pages": "Страницы", "pagesRepresentation": "TabsOnTop", "children": [
      { "page": "Основное", "title": "Основное", "children": [
        { "group": "horizontalIfPossible", "name": "ГруппаНаименования", "children": [
          { "input": "ПолноеНаименование", "path": "Объект.ПолноеНаименование" },
          { "input": "СокращенноеНаименование", "path": "Объект.СокращенноеНаименование" }
        ]},
        { "group": "horizontalIfPossible", "name": "ГруппаКлассификация", "children": [
          { "input": "Категория", "path": "Объект.Категория" },
          { "input": "ВидДолжности", "path": "Объект.ВидДолжности" }
        ]},
        { "input": "Разряд", "path": "Объект.Разряд", "title": "Тарифный разряд", "spinButton": true, "maxWidth": 15, "autoMaxWidth": false },
        { "group": "horizontalIfPossible", "name": "ГруппаКодДолжности", "children": [
          { "input": "КодДолжности", "path": "Объект.КодДолжности" },
          { "input": "КодГруппыИНомер", "path": "Объект.КодГруппыИНомер" }
        ]},
        { "group": "horizontalIfPossible", "name": "ГруппаОтпуска", "children": [
          { "input": "ОсновнойОтпуск", "path": "Объект.ОсновнойОтпуск", "title": "Осн. отпуск (дней)", "spinButton": true },
          { "input": "ДополнительныйОтпуск", "path": "Объект.ДополнительныйОтпуск", "title": "Доп. отпуск (дней)", "spinButton": true },
          { "input": "ПоправочныйКоэффициент", "path": "Объект.ПоправочныйКоэффициент" }
        ]}
      ]},
      { "page": "Классификатор", "title": "Классификатор", "children": [
        { "input": "КлассификаторЗанятий", "path": "Объект.КлассификаторЗанятий" },
        { "group": "horizontalIfPossible", "name": "ГруппаКодов", "children": [
          { "input": "КодКатегорииРаботников", "path": "Объект.КодКатегорииРаботников" },
          { "input": "КодКвалификационнойДолжности", "path": "Объект.КодКвалификационнойДолжности" },
          { "input": "КодПроизводной", "path": "Объект.КодПроизводной" }
        ]},
        { "input": "ГруппаДляМинТруда", "path": "Объект.ГруппаДляМинТруда" },
        { "input": "ГруппаДляСтатОтчетности", "path": "Объект.ГруппаДляСтатОтчетности" },
        { "input": "ГруппаДляПовышенияКвалификации", "path": "Объект.ГруппаДляПовышенияКвалификации" },
        { "input": "ГруппаДляППС", "path": "Объект.ГруппаДляППС" }
      ]},
      { "page": "Настройки", "title": "Настройки", "children": [
        { "check": "ПодлежитАттестации", "path": "Объект.ПодлежитАттестации" },
        { "check": "ОтношениеКПедагогическомуПерсоналу", "path": "Объект.ОтношениеКПедагогическомуПерсоналу" }
      ]}
    ]}
  ],
  "attributes": [
    { "name": "Объект", "type": "CatalogObject.Должности", "main": true }
  ]
}
