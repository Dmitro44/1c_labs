#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Лог = ВыполнитьЗагрузкуНаСервере();
	Сообщить(Лог);
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	// Загрузка выполнена при создании формы на сервере — завершаем сеанс.
	ПодключитьОбработчикОжидания("ЗавершитьСеанс", 0.3, Истина);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗагрузитьОбработка(Команда)
	Лог = ВыполнитьЗагрузкуНаСервере();
	Сообщить(Лог);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиОжидания

&НаКлиенте
Процедура ЗавершитьСеанс() Экспорт
	ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ВыполнитьЗагрузкуНаСервере()
	ДемоДанныеСервер.ЗагрузитьДемоДанные();
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Страны
	|ИЗ
	|	Справочник.СтраныМира КАК СтраныМира
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*)
	|ИЗ
	|	Справочник.Подразделения
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*)
	|ИЗ
	|	Справочник.Должности
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*)
	|ИЗ
	|	Справочник.Сотрудники
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*)
	|ИЗ
	|	Справочник.Надбавки";
	Результат = "";
	Для Каждого Строка Из Запрос.Выполнить().Выгрузить() Цикл
		Результат = Результат + Формат(Строка.Страны, "ЧГ=0") + " ";
	КонецЦикла;
	Возврат СтрШаблон("Загружено. Страны/Подразделения/Должности/Сотрудники/Надбавки: %1", СокрЛП(Результат));
КонецФункции

#КонецОбласти
