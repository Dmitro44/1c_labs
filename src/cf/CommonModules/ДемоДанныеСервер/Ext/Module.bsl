		Объект.ОсновнойОтпуск = 28;
		Объект.Разряд = 25;
		Объект.Записать();
	КонецЕсли;

	Ссылка = Справочники.Должности.НайтиПоКоду("000000042", Ложь);
	Если Не ЗначениеЗаполнено(Ссылка) Или Ссылка.Пустая() Тогда
		Объект = Справочники.Должности.СоздатьЭлемент();
