Функция НайтиИлиСоздатьГруппуПодразделений(Наименование, Код, КодПодразделения, ПолноеНаименование)
	Ссылка = Справочники.Подразделения.НайтиПоНаименованию(Наименование, Истина);
	Если ЗначениеЗаполнено(Ссылка) И Не Ссылка.Пустая() Тогда
		Если Ссылка.ЭтоГруппа Тогда
			Возврат Ссылка;
		КонецЕсли;
		// существовал как обычный элемент — переделываем в группу
		Ссылка.ПолучитьОбъект().Удалить();
	КонецЕсли;
	Группа = Справочники.Подразделения.СоздатьГруппу();
	Группа.Код = Код;
	Группа.Наименование = Наименование;
	Группа.ПолноеНаименование = ПолноеНаименование;
	Группа.КраткоеНаименование = Наименование;
	Группа.КодПодразделения = КодПодразделения;
	Группа.Записать();
	Возврат Группа.Ссылка;
КонецФункции

