КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НайтиИлиСоздатьЭлемент(ИмяСправочника, Наименование, Код = Неопределено)
	Ссылка = Справочники[ИмяСправочника].НайтиПоНаименованию(Наименование, Истина);
	Если ЗначениеЗаполнено(Ссылка) И Не Ссылка.Пустая() Тогда
		Возврат Ссылка;
	КонецЕсли;
	Объект = Справочники[ИмяСправочника].СоздатьЭлемент();
	Объект.Наименование = Наименование;
	Если Код <> Неопределено Тогда
		Объект.Код = Код;
	КонецЕсли;
	Объект.Записать();
	Возврат Объект.Ссылка;
КонецФункции

Функция НовыйЭлементСправочника(ИмяСправочника, Код, Наименование)
	Объект = Справочники[ИмяСправочника].СоздатьЭлемент();
	Объект.Код = Код;
	Объект.Наименование = Наименование;
	Возврат Объект;
КонецФункции

Функция НайтиИлиСоздатьГруппу(ИмяСправочника, Наименование)
	Ссылка = Справочники[ИмяСправочника].НайтиПоНаименованию(Наименование, Истина);
	Если ЗначениеЗаполнено(Ссылка) И Не Ссылка.Пустая() Тогда
		Возврат Ссылка;
	КонецЕсли;
	Объект = Справочники[ИмяСправочника].СоздатьГруппу();
	Объект.Наименование = Наименование;
	Объект.Записать();
	Возврат Объект.Ссылка;
КонецФункции

Процедура ЗагрузитьТипыАдресов()
	МассивТиповНП = Новый Массив;
	МассивТиповНП.Добавить("г.");
	МассивТиповНП.Добавить("аг.");
	МассивТиповНП.Добавить("п.");
	МассивТиповНП.Добавить("д.");
	Для Каждого Тип Из МассивТиповНП Цикл
		НайтиИлиСоздатьЭлемент("ТипНаселенногоПункта", Тип);
	КонецЦикла;
	МассивТиповУлиц = Новый Массив;
	МассивТиповУлиц.Добавить("ул.");
	МассивТиповУлиц.Добавить("пр-т");
	МассивТиповУлиц.Добавить("пер.");
	МассивТиповУлиц.Добавить("б-р");
	МассивТиповУлиц.Добавить("пл.");
	Для Каждого Тип Из МассивТиповУлиц Цикл
		НайтиИлиСоздатьЭлемент("ТипУлицы", Тип);
	КонецЦикла;
КонецПроцедуры

Процедура ЗагрузитьАдреса()
	Область = НайтиИлиСоздатьГруппу("Адрес", "Минская область");
	Минск = НайтиИлиСоздатьГруппу("Адрес", "г. Минск");
	ОбъектМинск = Минск.ПолучитьОбъект();
	Если Не ЗначениеЗаполнено(ОбъектМинск.Родитель) Тогда
		ОбъектМинск.Родитель = Область;
		ОбъектМинск.Записать();
	КонецЕсли;
	Улица = НайтиИлиСоздатьЭлемент("Адрес", "ул. Платонова");
	ОбъектУлица = Улица.ПолучитьОбъект();
	Если Не ЗначениеЗаполнено(ОбъектУлица.Родитель) Тогда
		ОбъектУлица.Родитель = Минск;
		ОбъектУлица.Записать();
	КонецЕсли;
	Проспект = НайтиИлиСоздатьЭлемент("Адрес", "пр-т Независимости");
	ОбъектПроспект = Проспект.ПолучитьОбъект();
	Если Не ЗначениеЗаполнено(ОбъектПроспект.Родитель) Тогда
		ОбъектПроспект.Родитель = Минск;
		ОбъектПроспект.Записать();
	КонецЕсли;
КонецПроцедуры

