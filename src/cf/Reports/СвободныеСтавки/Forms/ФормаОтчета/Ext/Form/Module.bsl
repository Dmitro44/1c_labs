#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Дата = ТекущаяДатаСеанса();
	Элементы.Дата.Формат = "ДФ=dd.MM.yyyy";
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сформировать(Команда)
	Попытка
		СформироватьНаСервере();
	Исключение
		Предупреждение(ОписаниеОшибки(), НСтр("ru = 'Ошибка формирования'"));
	КонецПопытки;
КонецПроцедуры


&НаКлиенте
Процедура ВыбратьВариант(Команда)
	ПоказатьОповещениеПользователя(, , НСтр("ru = 'У отчета один вариант формирования.'"));
КонецПроцедуры

&НаКлиенте
Процедура Настройки(Команда)
	ПоказатьОповещениеПользователя(, , НСтр("ru = 'Настройки отчета задаются фильтрами формы.'"));
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СформироватьНаСервере()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ШЕ.Подразделение КАК Подразделение,
	|	ШЕ.Должность КАК Должность,
	|	ШЕ.ВидФинансирования КАК ВидФинансирования,
	|	ШЕ.Ставка КАК СтавкиВШтатном,
	|	ЕСТЬNULL(Занятость.СтавкаОстаток, 0) КАК ЗанятыеСтавки
	|ИЗ
	|	РегистрСведений.ШтатныеЕдиницы.СрезПоследних(
	|		&Дата,
	|		(&ПодразделенияПусто ИЛИ Подразделение В (&Подразделения))
	|			И (&ДолжностиПусто ИЛИ Должность В (&Должности))
	|			И (&ВидыФинПусто ИЛИ ВидФинансирования В (&ВидыФин))) КАК ШЕ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РегистрУчетаСотрудников.Остатки(&Дата) КАК Занятость
	|		ПО ШЕ.Подразделение = Занятость.Подразделения
	|			И ШЕ.Должность = Занятость.Должности
	|			И ШЕ.ВидФинансирования = Занятость.ВидФинансирования
	|
	|УПОРЯДОЧИТЬ ПО
	|	Подразделение,
	|	Должность";
	Запрос.УстановитьПараметр("Дата", КонецДня(Дата));
	Запрос.УстановитьПараметр("Подразделения", Подразделения);
	Запрос.УстановитьПараметр("ПодразделенияПусто", Подразделения.Количество() = 0);
	Запрос.УстановитьПараметр("Должности", Должности);
	Запрос.УстановитьПараметр("ДолжностиПусто", Должности.Количество() = 0);
	Запрос.УстановитьПараметр("ВидыФин", ВидыФинансирования);
	Запрос.УстановитьПараметр("ВидыФинПусто", ВидыФинансирования.Количество() = 0);

	Выборка = Запрос.Выполнить().Выбрать();

	Результат.Очистить();

	// Ширины колонок задаются до объединения ячеек
	Результат.Область(1, 1, 1, 1).ШиринаКолонки = 17;
	Результат.Область(1, 2, 1, 2).ШиринаКолонки = 18;
	Результат.Область(1, 3, 1, 3).ШиринаКолонки = 18;
	Результат.Область(1, 4, 1, 4).ШиринаКолонки = 12;
	Результат.Область(1, 5, 1, 5).ШиринаКолонки = 9;
	Результат.Область(1, 6, 1, 6).ШиринаКолонки = 12;

	Результат.Область(1, 1, 1, 6).Объединить();
	Результат.Область(1, 1, 1, 6).Текст = "Свободные ставки на " + Формат(Дата, "ДФ=dd.MM.yyyy");
	Результат.Область(1, 1, 1, 6).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	Результат.Область(1, 1, 1, 6).Шрифт = Новый Шрифт(, 12, Истина);

	Результат.Область(2, 1, 2, 1).Текст = "Подразделение";
	Результат.Область(2, 2, 2, 2).Текст = "Должность";
	Результат.Область(2, 3, 2, 3).Текст = "Вид финансирования";
	Результат.Область(2, 4, 2, 4).Текст = "Ставки в штатном расписании";
	Результат.Область(2, 5, 2, 5).Текст = "Занятые ставки";
	Результат.Область(2, 6, 2, 6).Текст = "Свободные ставки";
	Результат.Область(2, 1, 2, 6).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	Результат.Область(2, 1, 2, 6).ВертикальноеПоложение = ВертикальноеПоложение.Центр;
	Результат.Область(2, 1, 2, 6).РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
	Результат.Область(2, 1, 2, 6).Шрифт = Новый Шрифт(, 9, Истина);

	Строка = 3;
	Пока Выборка.Следующий() Цикл
		Свободные = Выборка.СтавкиВШтатном - Выборка.ЗанятыеСтавки;
		Результат.Область(Строка, 1, Строка, 1).Текст = Строка(Выборка.Подразделение);
		Результат.Область(Строка, 2, Строка, 2).Текст = Строка(Выборка.Должность);
		Результат.Область(Строка, 3, Строка, 3).Текст = Строка(Выборка.ВидФинансирования);
		Результат.Область(Строка, 4, Строка, 4).Текст = Формат(Выборка.СтавкиВШтатном, "ЧДЦ=2");
		Результат.Область(Строка, 4, Строка, 4).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
		Результат.Область(Строка, 5, Строка, 5).Текст = Формат(Выборка.ЗанятыеСтавки, "ЧДЦ=2");
		Результат.Область(Строка, 5, Строка, 5).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
		Результат.Область(Строка, 6, Строка, 6).Текст = ?(Свободные > 0, Формат(Свободные, "ЧДЦ=2"), "");
		Результат.Область(Строка, 6, Строка, 6).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
		Строка = Строка + 1;
	КонецЦикла;

	// Сетка таблицы: обводим каждую ячейку, чтобы линии были видны
	Рамка = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная);
	Для НомерСтроки = 2 По Строка - 1 Цикл
		Для НомерКолонки = 1 По 6 Цикл
			Результат.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки)
				.Обвести(Рамка, Рамка, Рамка, Рамка);
		КонецЦикла;
	КонецЦикла;

	// Перенос длинных наименований и выравнивание по вертикали
	Если Строка > 3 Тогда
		Результат.Область(3, 1, Строка - 1, 3).РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
		Результат.Область(3, 1, Строка - 1, 6).ВертикальноеПоложение = ВертикальноеПоложение.Центр;
	КонецЕсли;


КонецПроцедуры

#КонецОбласти
