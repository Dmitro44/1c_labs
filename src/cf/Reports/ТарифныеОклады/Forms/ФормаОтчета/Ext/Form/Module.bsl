#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Дата = ТекущаяДатаСеанса();
	Элементы.Дата.Формат = "ДФ=dd.MM.yyyy";
	БазоваяВеличина = 297;
	СтавкаПервогоРазряда = 42;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сформировать(Команда)
	Попытка
		СформироватьНаСервере();
	Исключение
		ПоказатьОповещениеПользователя(НСтр("ru = 'Ошибка формирования'"), ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры


&НаКлиенте
Процедура ВыбратьВариант(Команда)
	ПоказатьОповещениеПользователя(, , НСтр("ru = 'У отчета один вариант формирования.'"));
КонецПроцедуры

&НаКлиенте
Процедура Настройки(Команда)
	ПоказатьОповещениеПользователя(, , НСтр("ru = 'Настройки отчета задаются фильтрами формы.'"));
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции


&НаСервере
Процедура СформироватьНаСервере()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ШЕ.Должность КАК Должность,
	|	МАКСИМУМ(ШЕ.Разряд) КАК Разряд,
	|	Долж.ПоправочныйКоэффициент КАК ПоправочныйКоэффициент
	|ИЗ
	|	РегистрСведений.ШтатныеЕдиницы.СрезПоследних(&Дата) КАК ШЕ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Должности КАК Долж
	|		ПО ШЕ.Должность = Долж.Ссылка
	|ГДЕ
	|	&ВидыФинПусто ИЛИ ШЕ.ВидФинансирования В (&ВидыФин)
	|	И (&ДолжностиПусто ИЛИ ШЕ.Должность В ИЕРАРХИИ (&Должности))
	|
	|СГРУППИРОВАТЬ ПО
	|	ШЕ.Должность,
	|	Долж.ПоправочныйКоэффициент
	|
	|УПОРЯДОЧИТЬ ПО
	|	Разряд УБЫВ";
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("ВидыФин", ВидыФинансирования);
	Запрос.УстановитьПараметр("ВидыФинПусто", ВидыФинансирования.Количество() = 0);
	Запрос.УстановитьПараметр("Должности", Должности);
	Запрос.УстановитьПараметр("ДолжностиПусто", Должности.Количество() = 0);

	Выборка = Запрос.Выполнить().Выбрать();

	Результат.Очистить();

	// Ширины колонок задаются до объединения ячеек
	Результат.Область(1, 1, 1, 1).ШиринаКолонки = 24;
	Результат.Область(1, 2, 1, 2).ШиринаКолонки = 8;
	Результат.Область(1, 3, 1, 3).ШиринаКолонки = 7;
	Результат.Область(1, 4, 1, 4).ШиринаКолонки = 14;
	Результат.Область(1, 5, 1, 5).ШиринаКолонки = 18;
	Результат.Область(1, 6, 1, 6).ШиринаКолонки = 16;

	Рамка = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная);
	Центр = ГоризонтальноеПоложение.Центр;
	Право = ГоризонтальноеПоложение.Право;

	// Блок показателей справа сверху
	Результат.Область(1, 4, 1, 5).Объединить();
	Результат.Область(1, 4, 1, 5).Текст = "Базовая величина:";
	Результат.Область(1, 4, 1, 5).ГоризонтальноеПоложение = Право;
	Результат.Область(1, 4, 1, 5).ВертикальноеПоложение = ВертикальноеПоложение.Центр;
	Результат.Область(1, 6, 1, 6).Текст = Формат(БазоваяВеличина, "ЧДЦ=2");
	Результат.Область(1, 6, 1, 6).ГоризонтальноеПоложение = Центр;
	Результат.Область(1, 6, 1, 6).Обвести(Рамка, Рамка, Рамка, Рамка);

	Результат.Область(2, 4, 2, 5).Объединить();
	Результат.Область(2, 4, 2, 5).Текст = "Тарифная ставка 1-го разряда:";
	Результат.Область(2, 4, 2, 5).ГоризонтальноеПоложение = Право;
	Результат.Область(2, 4, 2, 5).ВертикальноеПоложение = ВертикальноеПоложение.Центр;
	Результат.Область(2, 6, 2, 6).Текст = Формат(СтавкаПервогоРазряда, "ЧДЦ=2");
	Результат.Область(2, 6, 2, 6).ГоризонтальноеПоложение = Центр;
	Результат.Область(2, 6, 2, 6).Обвести(Рамка, Рамка, Рамка, Рамка);

	// Заголовок отчета
	Результат.Область(4, 1, 4, 6).Объединить();
	Результат.Область(4, 1, 4, 6).Текст = "Список тарифных окладов на " + Формат(Дата, "ДФ=dd.MM.yyyy");
	Результат.Область(4, 1, 4, 6).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	Результат.Область(4, 1, 4, 6).Шрифт = Новый Шрифт(, 12, Истина);

	Результат.Область(5, 1, 5, 6).Объединить();
	Результат.Область(5, 1, 5, 6).Текст = "Персонал:";
	Результат.Область(5, 1, 5, 6).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	Результат.Область(5, 1, 5, 6).Шрифт = Новый Шрифт(, 9, Истина);

	// Шапка таблицы: строки 6-7, ниже строка нумерации граф (строка 8)
	Результат.Область(6, 1, 7, 1).Объединить();
	Результат.Область(6, 1, 7, 1).Текст = "Должности";

	Результат.Область(6, 2, 6, 3).Объединить();
	Результат.Область(6, 2, 6, 3).Текст = "Показатели по ЕТС";
	Результат.Область(7, 2, 7, 2).Текст = "Тар. разряд";
	Результат.Область(7, 3, 7, 3).Текст = "Тар. коэф.";

	Результат.Область(6, 4, 7, 4).Объединить();
	Результат.Область(6, 4, 7, 4).Текст = "Поправ. коэффициент";

	Результат.Область(6, 5, 7, 5).Объединить();
	Результат.Область(6, 5, 7, 5).Текст = "Корректирующий коэффициент";

	Результат.Область(6, 6, 7, 6).Объединить();
	Результат.Область(6, 6, 7, 6).Текст = "Исходный оклад (ставки) по ЕТС (руб., коп.)";

	Результат.Область(6, 1, 7, 6).ГоризонтальноеПоложение = Центр;
	Результат.Область(6, 1, 7, 6).ВертикальноеПоложение = ВертикальноеПоложение.Центр;
	Результат.Область(6, 1, 7, 6).РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
	Результат.Область(6, 1, 7, 6).Шрифт = Новый Шрифт(, 9, Истина);

	// Строка нумерации граф
	Для НомерГрафы = 1 По 6 Цикл
		Результат.Область(8, НомерГрафы, 8, НомерГрафы).Текст = НомерГрафы;
	КонецЦикла;
	Результат.Область(8, 1, 8, 6).ГоризонтальноеПоложение = Центр;
	Результат.Область(8, 1, 8, 6).Шрифт = Новый Шрифт(, 9, Истина);

	// Строки данных
	Строка = 9;
	Пока Выборка.Следующий() Цикл
		ТарКоэфф = ТарифныйКоэффициент(Выборка.Разряд);
		Поправочный = ?(ЗначениеЗаполнено(Выборка.ПоправочныйКоэффициент), Выборка.ПоправочныйКоэффициент, 0);
		Оклад = Окр(БазоваяВеличина * ТарКоэфф * ?(Поправочный > 0, Поправочный, 1), 2);

		Результат.Область(Строка, 1, Строка, 1).Текст = Строка(Выборка.Должность);
		Результат.Область(Строка, 1, Строка, 1).РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;

		Результат.Область(Строка, 2, Строка, 2).Текст = Формат(Выборка.Разряд, "ЧГ=0");
		Результат.Область(Строка, 2, Строка, 2).ГоризонтальноеПоложение = Центр;

		Результат.Область(Строка, 3, Строка, 3).Текст = СтрЗаменить(Формат(ТарКоэфф, "ЧДЦ=2"), ",00", "");
		Результат.Область(Строка, 3, Строка, 3).ГоризонтальноеПоложение = Центр;

		Результат.Область(Строка, 4, Строка, 4).Текст = ?(Поправочный > 0,
			СтрЗаменить(Формат(Поправочный, "ЧДЦ=2"), ",00", ""), "");
		Результат.Область(Строка, 4, Строка, 4).ГоризонтальноеПоложение = Центр;

		Результат.Область(Строка, 5, Строка, 5).Текст = 1;
		Результат.Область(Строка, 5, Строка, 5).ГоризонтальноеПоложение = Центр;

		Результат.Область(Строка, 6, Строка, 6).Текст = Формат(Оклад, "ЧДЦ=2");
		Результат.Область(Строка, 6, Строка, 6).ГоризонтальноеПоложение = Право;

		Результат.Область(Строка, 1, Строка, 6).ВертикальноеПоложение = ВертикальноеПоложение.Центр;
		Строка = Строка + 1;
	КонецЦикла;

	// Сетка таблицы: обводим каждую ячейку, чтобы линии были видны
	Для НомерСтроки = 6 По Строка - 1 Цикл
		Для НомерКолонки = 1 По 6 Цикл
			Результат.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки)
				.Обвести(Рамка, Рамка, Рамка, Рамка);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Тарифный коэффициент ЕТС по разряду.
// Значения 14-18 разрядов — из данных методички, младшие — по шкале ЕТС.
&НаСервере
Функция ТарифныйКоэффициент(Разряд)

	Если Не ЗначениеЗаполнено(Разряд) Или Разряд < 1 Или Разряд > 18 Тогда
		Возврат 1;
	КонецЕсли;

	Коэффициенты = Новый Массив(18);
	Коэффициенты[0]  = 1;     // 1
	Коэффициенты[1]  = 1.04;  // 2
	Коэффициенты[2]  = 1.09;  // 3
	Коэффициенты[3]  = 1.16;  // 4
	Коэффициенты[4]  = 1.23;  // 5
	Коэффициенты[5]  = 1.32;  // 6
	Коэффициенты[6]  = 1.41;  // 7
	Коэффициенты[7]  = 1.51;  // 8
	Коэффициенты[8]  = 1.62;  // 9
	Коэффициенты[9]  = 1.73;  // 10
	Коэффициенты[10] = 1.85;  // 11
	Коэффициенты[11] = 1.98;  // 12
	Коэффициенты[12] = 2.14;  // 13
	Коэффициенты[13] = 2.31;  // 14
	Коэффициенты[14] = 2.47;  // 15
	Коэффициенты[15] = 2.63;  // 16
	Коэффициенты[16] = 2.81;  // 17
	Коэффициенты[17] = 3;     // 18

	Возврат Коэффициенты[Разряд - 1];

КонецФункции

#КонецОбласти
