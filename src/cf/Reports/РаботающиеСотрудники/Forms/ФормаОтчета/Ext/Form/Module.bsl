#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ДатаНачала = НачалоМесяца(ТекущаяДатаСеанса());
	ДатаОкончания = КонецМесяца(ТекущаяДатаСеанса());
	Элементы.ДатаНачала.Формат = "ДФ=dd.MM.yyyy";
	Элементы.ДатаОкончания.Формат = "ДФ=dd.MM.yyyy";
	ВидОтображения = "Списком";
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сформировать(Команда)
	Попытка
		СформироватьНаСервере();
	Исключение
		ПоказатьОповещениеПользователя(НСтр("ru = 'Ошибка формирования'"), ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры


&НаКлиенте
Процедура Проверить(Команда)
	Если Не ЗначениеЗаполнено(ДатаНачала) Или Не ЗначениеЗаполнено(ДатаОкончания) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите период отчета.'"));
		Возврат;
	КонецЕсли;
	Если ДатаОкончания < ДатаНачала Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Дата окончания периода меньше даты начала.'"));
		Возврат;
	КонецЕсли;
	ПоказатьОповещениеПользователя(, , НСтр("ru = 'Параметры отчета заполнены корректно.'"));
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СформироватьНаСервере()

	Запрос = Новый Запрос;

	// Группировка в макете возможна только при сортировке по полю группировки,
	// иначе строки одной группы окажутся разорваны другими группами.
	ПолеСортировки = "";
	Если ВидОтображения = "По подразделениям" Тогда
		ПолеСортировки = "Подразделение, ";
	ИначеЕсли ВидОтображения = "По виду персонала" Тогда
		ПолеСортировки = "ВидФинансирования, ";
	КонецЕсли;

	Запрос.Текст =
	"ВЫБРАТЬ
	|	Рег.Сотрудники КАК Сотрудник,
	|	Рег.Подразделения КАК Подразделение,
	|	Рег.Должности КАК Должность,
	|	Рег.ВидФинансирования КАК ВидФинансирования,
	|	Сотрудник.Наименование КАК ФИО,
	|	Сотрудник.ДатаРождения КАК ДатаРождения,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА Рег.СтавкаКонечныйОстаток > 0
	|				ТОГДА Рег.СтавкаКонечныйОстаток
	|			ИНАЧЕ Рег.СтавкаНачальныйОстаток
	|		КОНЕЦ) КАК Ставка
	|ИЗ
	|	РегистрНакопления.РегистрУчетаСотрудников.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, , , ) КАК Рег
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Сотрудники КАК Сотрудник
	|		ПО Рег.Сотрудники = Сотрудник.Ссылка
	|ГДЕ
	|	(Рег.СтавкаНачальныйОстаток > 0 ИЛИ Рег.СтавкаПриход > 0)
	|	И (&ВидыРаботыПусто ИЛИ Рег.ВидыРаботы В (&ВидыРаботы))
	|	И (&ВидыФинПусто ИЛИ Рег.ВидФинансирования В (&ВидыФин))
	|	И (&ПодразделенияПусто ИЛИ Рег.Подразделения В (&Подразделения))
	|	И (&ДолжностиПусто ИЛИ Рег.Должности В (&Должности))
	|	И (НЕ &ИспользоватьПол ИЛИ Сотрудник.Пол = &Пол)
	|	И (НЕ &ИспользоватьДоговор ИЛИ Сотрудник.ВидКомплектования = &ВидДоговора)
	|
	|СГРУППИРОВАТЬ ПО
	|	Рег.Сотрудники,
	|	Рег.Подразделения,
	|	Рег.Должности,
	|	Рег.ВидФинансирования,
	|	Сотрудник.Наименование,
	|	Сотрудник.ДатаРождения
	|
	|УПОРЯДОЧИТЬ ПО
	|	" + ПолеСортировки + "ФИО";
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ДатаОкончания));
	Запрос.УстановитьПараметр("ВидыРаботы", ВидыРаботы);
	Запрос.УстановитьПараметр("ВидыРаботыПусто", ВидыРаботы.Количество() = 0);
	Запрос.УстановитьПараметр("ВидыФин", ВидыФинансирования);
	Запрос.УстановитьПараметр("ВидыФинПусто", ВидыФинансирования.Количество() = 0);
	Запрос.УстановитьПараметр("Подразделения", Подразделения);
	Запрос.УстановитьПараметр("ПодразделенияПусто", Подразделения.Количество() = 0);
	Запрос.УстановитьПараметр("Должности", Должности);
	Запрос.УстановитьПараметр("ДолжностиПусто", Должности.Количество() = 0);
	Запрос.УстановитьПараметр("ИспользоватьПол", ЗначениеЗаполнено(Пол));
	Запрос.УстановитьПараметр("Пол", Пол);
	Запрос.УстановитьПараметр("ИспользоватьДоговор", ЗначениеЗаполнено(ВидДоговора));
	Запрос.УстановитьПараметр("ВидДоговора", ВидДоговора);

	Результат.Очистить();

	// Ширины колонок задаются до объединения ячеек
	Результат.Область(1, 1, 1, 1).ШиринаКолонки = 4;
	Результат.Область(1, 2, 1, 2).ШиринаКолонки = 25;
	Результат.Область(1, 3, 1, 3).ШиринаКолонки = 24;
	Результат.Область(1, 4, 1, 4).ШиринаКолонки = 7;
	Результат.Область(1, 5, 1, 5).ШиринаКолонки = 13;

	Результат.Область(1, 1, 1, 5).Объединить();
	Результат.Область(1, 1, 1, 5).Текст = "Список сотрудников, работавших";
	Результат.Область(1, 1, 1, 5).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	Результат.Область(1, 1, 1, 5).Шрифт = Новый Шрифт(, 12, Истина);
	Результат.Область(2, 1, 2, 5).Объединить();
	Результат.Область(2, 1, 2, 5).Текст =
		"в течение периода с " + Формат(ДатаНачала, "ДФ=dd.MM.yyyy")
		+ " по " + Формат(ДатаОкончания, "ДФ=dd.MM.yyyy");
	Результат.Область(2, 1, 2, 5).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	Результат.Область(2, 1, 2, 5).Шрифт = Новый Шрифт(, 12, Истина);

	Результат.Область(3, 1, 3, 1).Текст = "№";
	Результат.Область(3, 2, 3, 2).Текст = "Ф.И.О.";
	Результат.Область(3, 3, 3, 3).Текст = "Должность";
	Результат.Область(3, 4, 3, 4).Текст = "Ставка";
	Результат.Область(3, 5, 3, 5).Текст = "Дата рождения";
	Результат.Область(3, 1, 3, 5).Шрифт = Новый Шрифт(, 9, Истина);
	Для НомерГрафы = 1 По 5 Цикл
		Результат.Область(4, НомерГрафы, 4, НомерГрафы).Текст = НомерГрафы;
	КонецЦикла;
	Результат.Область(3, 1, 4, 5).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	Результат.Область(3, 1, 4, 5).ВертикальноеПоложение = ВертикальноеПоложение.Центр;

	ШрифтГруппы = Неопределено;
	Попытка
		ШрифтГруппы = Новый Шрифт(, 9, Ложь, , Истина);
	Исключение
		Попытка
			ШрифтГруппы = Новый Шрифт(, 9, Ложь, Истина);
		Исключение
			ШрифтГруппы = Новый Шрифт(, 9, Ложь);
		КонецПопытки;
	КонецПопытки;

	Строка = 5;
	Номер = 1;
	ТекущаяГруппа = "";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Если ВидОтображения = "По подразделениям" ИЛИ ВидОтображения = "По виду персонала" Тогда
			Группа = ?(ВидОтображения = "По подразделениям",
				Строка(Выборка.Подразделение), Строка(Выборка.ВидФинансирования));
			Если Группа <> ТекущаяГруппа Тогда
				ТекущаяГруппа = Группа;
				Результат.Область(Строка, 1, Строка, 5).Объединить();
				Результат.Область(Строка, 1, Строка, 5).Текст = Группа;
				Результат.Область(Строка, 1, Строка, 5).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
				Если ШрифтГруппы <> Неопределено Тогда
					Результат.Область(Строка, 1, Строка, 5).Шрифт = ШрифтГруппы;
				КонецЕсли;
				Строка = Строка + 1;
				Номер = 1;
			КонецЕсли;
		КонецЕсли;

		Результат.Область(Строка, 1, Строка, 1).Текст = Номер;
		Результат.Область(Строка, 1, Строка, 1).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
		Результат.Область(Строка, 2, Строка, 2).Текст = Выборка.ФИО;
		Результат.Область(Строка, 2, Строка, 2).РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
		Результат.Область(Строка, 3, Строка, 3).Текст = Строка(Выборка.Должность);
		Результат.Область(Строка, 3, Строка, 3).РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
		Результат.Область(Строка, 4, Строка, 4).Текст = Формат(Выборка.Ставка, "ЧДЦ=2");
		Результат.Область(Строка, 4, Строка, 4).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
		Результат.Область(Строка, 5, Строка, 5).Текст = Формат(Выборка.ДатаРождения, "ДФ=dd.MM.yyyy");
		Результат.Область(Строка, 5, Строка, 5).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
		Строка = Строка + 1;
		Номер = Номер + 1;

	КонецЦикла;

	// Сетка таблицы: обводим каждую ячейку, чтобы линии были видны
	Рамка = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная);
	Для НомерСтроки = 1 По Строка - 1 Цикл
		Для НомерКолонки = 1 По 5 Цикл
			Результат.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки)
				.Обвести(Рамка, Рамка, Рамка, Рамка);
		КонецЦикла;
	КонецЦикла;

	// Выравнивание по вертикали
	Результат.Область(1, 1, Строка - 1, 5).ВертикальноеПоложение = ВертикальноеПоложение.Центр;


КонецПроцедуры

#КонецОбласти
