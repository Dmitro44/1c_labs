#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ДатаРасчета = ТекущаяДатаСеанса();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура РассчитатьОбработка(Команда)
	РассчитатьНаСервере();
	// Отдельной кнопки подтверждения на форме нет, поэтому расчёт
	// сразу отдаётся вызывающей форме и форма закрывается.
	ОповеститьОВыборе(
		Новый Структура("Лет, Месяцев, Дней, ДатаРасчета",
			Лет, Месяцев, Дней, ДатаРасчета));
КонецПроцедуры


#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Считает общий стаж по введённым периодам работы.
// Периоды без даты начала или с датой окончания раньше начала пропускаются,
// незакрытый период считается по ДатаРасчета.
&НаСервере
Процедура РассчитатьНаСервере()
	ВсегоМесяцев = 0;
	ВсегоДней = 0;
	Для Каждого Строка Из Периоды Цикл
		Если Не Строка.ВключатьВСтаж Тогда
			Продолжить;
		КонецЕсли;
		ДатаНач = Строка.ДатаС;
		ДатаКон = ?(ЗначениеЗаполнено(Строка.ДатаПо), Строка.ДатаПо, ДатаРасчета);
		Если Не ЗначениеЗаполнено(ДатаНач) Или Не ЗначениеЗаполнено(ДатаКон) Или ДатаКон < ДатаНач Тогда
			Продолжить;
		КонецЕсли;
		МесяцевПериода = (Год(ДатаКон) - Год(ДатаНач)) * 12 + (Месяц(ДатаКон) - Месяц(ДатаНач));
		ДнейПериода = День(ДатаКон) - День(ДатаНач);
		Если ДнейПериода < 0 Тогда
			МесяцевПериода = МесяцевПериода - 1;
			ПредыдущийМесяц = ДобавитьМесяц(ДатаКон, -1);
			ДнейПериода = ДнейПериода + День(КонецМесяца(ПредыдущийМесяц));
		КонецЕсли;
		ВсегоМесяцев = ВсегоМесяцев + МесяцевПериода;
		ВсегоДней = ВсегоДней + ДнейПериода;
	КонецЦикла;
	Лет = Цел(ВсегоМесяцев / 12);
	Месяцев = ВсегоМесяцев - Лет * 12;
	Дней = ВсегоДней;
КонецПроцедуры

#КонецОбласти
