#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Сотрудник = Параметры.Сотрудник;
	ДатаРасчета = ТекущаяДатаСеанса();
	Если ЗначениеЗаполнено(Сотрудник) Тогда
		Для Каждого Строка Из Сотрудник.ИсторияРабот Цикл
			НоваяСтрока = Периоды.Добавить();
			НоваяСтрока.ДатаС = Строка.ДатаС;
			НоваяСтрока.ДатаПо = Строка.ДатаПо;
			НоваяСтрока.Организация = Строка.Организация;
			НоваяСтрока.ВключатьВСтаж = Строка.ВключатьВСтаж;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура РассчитатьОбработка(Команда)
	РассчитатьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьВСправочникОбработка(Команда)
	Если Не ЗначениеЗаполнено(Сотрудник) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не указан сотрудник.'"));
		Возврат;
	КонецЕсли;
	РассчитатьНаСервере();
	ЗаписатьСтажНаСервере();
	Оповестить("СтажРассчитан", Новый Структура("Ссылка", Сотрудник), ЭтаФорма);
	Закрыть();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура РассчитатьНаСервере()
	ВсегоМесяцев = 0;
	ВсегоДней = 0;
	Для Каждого Строка Из Периоды Цикл
		Если Не Строка.ВключатьВСтаж Тогда
			Продолжить;
		КонецЕсли;
		ДатаНач = Строка.ДатаС;
		ДатаКон = ?(ЗначениеЗаполнено(Строка.ДатаПо), Строка.ДатаПо, ДатаРасчета);
		Если Не ЗначениеЗаполнено(ДатаНач) Или Не ЗначениеЗаполнено(ДатаКон) Или ДатаКон < ДатаНач Тогда
			Продолжить;
		КонецЕсли;
		МесяцевПериода = (Год(ДатаКон) - Год(ДатаНач)) * 12 + (Месяц(ДатаКон) - Месяц(ДатаНач));
		ДнейПериода = День(ДатаКон) - День(ДатаНач);
		Если ДнейПериода < 0 Тогда
			МесяцевПериода = МесяцевПериода - 1;
			ПредыдущийМесяц = ДобавитьМесяц(ДатаКон, -1);
			ДнейПериода = ДнейПериода + День(КонецМесяца(ПредыдущийМесяц));
		КонецЕсли;
		ВсегоМесяцев = ВсегоМесяцев + МесяцевПериода;
		ВсегоДней = ВсегоДней + ДнейПериода;
	КонецЦикла;
	Лет = Цел(ВсегоМесяцев / 12);
	Месяцев = ВсегоМесяцев - Лет * 12;
	Дней = ВсегоДней;
КонецПроцедуры

&НаСервере
Процедура ЗаписатьСтажНаСервере()
	ОбъектСотрудника = Сотрудник.ПолучитьОбъект();
	СтрокаСтажа = Неопределено;
	Для Каждого Строка Из ОбъектСотрудника.ВидыСтажа Цикл
		Если Строка.ВидСтажа = "Общий" Тогда
			СтрокаСтажа = Строка;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если СтрокаСтажа = Неопределено Тогда
		СтрокаСтажа = ОбъектСотрудника.ВидыСтажа.Добавить();
		СтрокаСтажа.ВидСтажа = "Общий";
	КонецЕсли;
	СтрокаСтажа.Лет = Лет;
	СтрокаСтажа.Месяцев = Месяцев;
	СтрокаСтажа.Дней = Дней;
	СтрокаСтажа.ДатаРасчета = НачалоДня(ДатаРасчета);
	ОбъектСотрудника.Записать();
КонецПроцедуры

#КонецОбласти
