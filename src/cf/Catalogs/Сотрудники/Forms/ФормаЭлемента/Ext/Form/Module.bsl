#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ДатаДляРасчета = ТекущаяДатаСеанса();
	Если ЗначениеЗаполнено(Объект.ФамилияИО) Тогда
		Заголовок = "Табельный № " + Объект.ТабельныйНомер + " " + Объект.ФамилияИО;
	Иначе
		Заголовок = "Сотрудник";
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ДобавитьСтажОбработка(Команда)
	// 7-й параметр — колбэк, который вызывается при закрытии формы
	// расчёта и получает значение из ОповеститьОВыборе.
	Оповещение = Новый ОписаниеОповещения("РасчетСтажаЗавершение", ЭтотОбъект);
	ОткрытьФорму("Справочник.Сотрудники.Форма.ФормаРасчетаСтажа",
		, ЭтаФорма, , , , Оповещение);
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьСтажОбработка(Команда)
	ТекущаяСтрока = Элементы.ВидыСтажа.ТекущаяСтрока;
	Если ТекущаяСтрока = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите строку стажа.'"));
		Возврат;
	КонецЕсли;
	Элементы.ВидыСтажа.НачатьИзменениеСтроки(ТекущаяСтрока);
КонецПроцедуры

&НаКлиенте
Процедура УдалитьСтажОбработка(Команда)
	ТекущаяСтрока = Элементы.ВидыСтажа.ТекущаяСтрока;
	Если ТекущаяСтрока = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите строку стажа.'"));
		Возврат;
	КонецЕсли;
	Объект.ВидыСтажа.Удалить(ТекущаяСтрока);
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьНаДатуОбработка(Команда)
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Сначала запишите сотрудника.'"));
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДатаДляРасчета) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите дату для расчёта.'"));
		Возврат;
	КонецЕсли;
	ТекущаяСтрока = Элементы.ВидыСтажа.ТекущаяСтрока;
	Если ТекущаяСтрока = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите строку стажа.'"));
		Возврат;
	КонецЕсли;
	Результат = РассчитатьСтажНаСервере(Объект.Ссылка, ДатаДляРасчета);
	Если Результат = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Нет периодов работы для расчёта.'"));
		Возврат;
	КонецЕсли;
	ТекущаяСтрока.Лет = Результат.Лет;
	ТекущаяСтрока.Месяцев = Результат.Месяцев;
	ТекущаяСтрока.Дней = Результат.Дней;
	ТекущаяСтрока.ДатаРасчета = НачалоДня(ДатаДляРасчета);
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьРебенкаОбработка(Команда)
	НоваяСтрока = Объект.Дети.Добавить();
	НоваяСтрока.ДатаРожденияРебенка = ДатаДляРасчета;
	Элементы.Дети.ТекущаяСтрока = НоваяСтрока;
	ПоказатьПредупреждение(, НСтр("ru = 'Заполните ФИО и дату рождения ребенка.'"));
КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

// Вызывается при закрытии формы расчёта стажа.
&НаКлиенте
Процедура РасчетСтажаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	НоваяСтрока = Объект.ВидыСтажа.Добавить();
	НоваяСтрока.Лет = Результат.Лет;
	НоваяСтрока.Месяцев = Результат.Месяцев;
	НоваяСтрока.Дней = Результат.Дней;
	НоваяСтрока.ДатаРасчета = НачалоДня(Результат.ДатаРасчета);
	Элементы.ВидыСтажа.ТекущаяСтрока = НоваяСтрока;
КонецПроцедуры

// Считает стаж по истории работ сотрудника на указанную дату.
// Незакрытый период берётся до ДатаРасчета, периоды с флажком
// «Включать в стаж», заданным снятым, пропускаются.
&НаСервере
Функция РассчитатьСтажНаСервере(Ссылка, ДатаРасчета)
	ВсегоМесяцев = 0;
	ВсегоДней = 0;
	ЕстьПериоды = Ложь;
	Для Каждого Строка Из Ссылка.ИсторияРабот Цикл
		Если Не Строка.ВключатьВСтаж Тогда
			Продолжить;
		КонецЕсли;
		ДатаНач = Строка.ДатаС;
		ДатаКон = ?(ЗначениеЗаполнено(Строка.ДатаПо), Строка.ДатаПо, ДатаРасчета);
		Если Не ЗначениеЗаполнено(ДатаНач) Или Не ЗначениеЗаполнено(ДатаКон) Или ДатаКон < ДатаНач Тогда
			Продолжить;
		КонецЕсли;
		ЕстьПериоды = Истина;
		МесяцевПериода = (Год(ДатаКон) - Год(ДатаНач)) * 12 + (Месяц(ДатаКон) - Месяц(ДатаНач));
		ДнейПериода = День(ДатаКон) - День(ДатаНач);
		Если ДнейПериода < 0 Тогда
			МесяцевПериода = МесяцевПериода - 1;
			ПредыдущийМесяц = ДобавитьМесяц(ДатаКон, -1);
			ДнейПериода = ДнейПериода + День(КонецМесяца(ПредыдущийМесяц));
		КонецЕсли;
		ВсегоМесяцев = ВсегоМесяцев + МесяцевПериода;
		ВсегоДней = ВсегоДней + ДнейПериода;
	КонецЦикла;
	Если Не ЕстьПериоды Тогда
		Возврат Неопределено;
	КонецЕсли;
	Лет = Цел(ВсегоМесяцев / 12);
	Возврат Новый Структура("Лет, Месяцев, Дней", Лет, ВсегоМесяцев - Лет * 12, ВсегоДней);
КонецФункции

#КонецОбласти