#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ДатаДляРасчета = ТекущаяДатаСеанса();
	Если ЗначениеЗаполнено(Объект.ФамилияИО) Тогда
		Заголовок = "Табельный № " + Объект.ТабельныйНомер + " " + Объект.ФамилияИО;
	Иначе
		Заголовок = "Сотрудник";
	КонецЕсли;
	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаЛичныеДанные;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы
#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПерейтиЛичныеДанные(Команда)
	УстановитьТекущуюСтраницу(Элементы.СтраницаЛичныеДанные);
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиАдрес(Команда)
	УстановитьТекущуюСтраницу(Элементы.СтраницаАдрес);
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиОбразование(Команда)
	УстановитьТекущуюСтраницу(Элементы.СтраницаОбразование);
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиСтаж(Команда)
	УстановитьТекущуюСтраницу(Элементы.СтраницаСтаж);
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиХарактеристики(Команда)
	УстановитьТекущуюСтраницу(Элементы.СтраницаХарактеристики);
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиРабота(Команда)
	УстановитьТекущуюСтраницу(Элементы.СтраницаРабота);
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиДети(Команда)
	УстановитьТекущуюСтраницу(Элементы.СтраницаДети);
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСтажОбработка(Команда)
	НоваяСтрока = Объект.ВидыСтажа.Добавить();
	НоваяСтрока.ДатаРасчета = ТекущаяДата();
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьСтажОбработка(Команда)
	ТекущаяСтрока = Элементы.ВидыСтажа.ТекущаяСтрока;
	Если ТекущаяСтрока = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите строку стажа.'"));
		Возврат;
	КонецЕсли;
	Элементы.ВидыСтажа.НачатьИзменениеСтроки(ТекущаяСтрока);
КонецПроцедуры

&НаКлиенте
Процедура УдалитьСтажОбработка(Команда)
	ТекущаяСтрока = Элементы.ВидыСтажа.ТекущаяСтрока;
	Если ТекущаяСтрока = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите строку стажа.'"));
		Возврат;
	КонецЕсли;
	Объект.ВидыСтажа.Удалить(ТекущаяСтрока);
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьНаДатуОбработка(Команда)
	ПараметрыФормы = Новый Структура("Сотрудник", Объект.Ссылка);
	ОткрытьФорму("Справочник.Сотрудники.Форма.ФормаРасчетаСтажа", ПараметрыФормы, ЭтаФорма);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиОповещений

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "СтажРассчитан" И Источник <> Неопределено И Параметр <> Неопределено Тогда
		Если Параметр.Ссылка = Объект.Ссылка Тогда
			ОбновитьСтажНаСервере(Параметр.Ссылка);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УстановитьТекущуюСтраницу(Страница)
	Элементы.Страницы.ТекущаяСтраница = Страница;
КонецПроцедуры

&НаСервере
Процедура ОбновитьСтажНаСервере(Ссылка)
	Объект.ВидыСтажа.Загрузить(Ссылка.ВидыСтажа.Выгрузить());
КонецПроцедуры

#КонецОбласти
