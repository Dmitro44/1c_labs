// Реквизит «Наименование» в форме элемента не редактируется, но в метаданных
// он обязательный — собираем его из ФИО, иначе сотрудника нельзя записать.
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	ЗаполнитьПредставления();
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	ЗаполнитьПредставления();
КонецПроцедуры

Процедура ЗаполнитьПредставления()

	ФамилияПолная = СокрЛП(Фамилия);
	ИмяПолное     = СокрЛП(Имя);
	ОтчествоПолное = СокрЛП(Отчество);

	ФИО = СокрЛП(ФамилияПолная + " " + ИмяПолное + " " + ОтчествоПолное);
	Если Не ПустаяСтрока(ФИО) Тогда
		Наименование = ФИО;
	КонецЕсли;

	Инициалы = "";
	Если Не ПустаяСтрока(ИмяПолное) Тогда
		Инициалы = Инициалы + Лев(ИмяПолное, 1) + ".";
	КонецЕсли;
	Если Не ПустаяСтрока(ОтчествоПолное) Тогда
		Инициалы = Инициалы + Лев(ОтчествоПолное, 1) + ".";
	КонецЕсли;

	Если Не ПустаяСтрока(ФамилияПолная) Тогда
		ФамилияИО = СокрЛП(ФамилияПолная + " " + Инициалы);
	КонецЕсли;

КонецПроцедуры
