#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ДобавитьОбработка(Команда)
	ВыделенныеСтроки = Элементы.Список.ВыделенныеСтроки;
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите должности в списке.'"));
		Возврат;
	КонецЕсли;
	Для Каждого Ссылка Из ВыделенныеСтроки Цикл
		ДобавитьДолжностьВВыбранные(Ссылка);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьДолжностьОбработка(Команда)
	ПараметрыВыбора = Новый Структура("РежимВыбора", Истина);
	Оповещение = Новый ОписаниеОповещения("ВыбратьДолжностьЗавершение", ЭтотОбъект);
	ОткрытьФорму("Справочник.Должности.ФормаВыбора", ПараметрыВыбора, ЭтаФорма,,,, Оповещение);
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьДолжностьЗавершение(Результат, ДополнительныеПараметры) Экспорт
	Если ЗначениеЗаполнено(Результат) Тогда
		ДобавитьДолжностьВВыбранные(Результат);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВсехОбработка(Команда)
	ВыбратьВсехНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьОбработка(Команда)
	Если ВыбранныеДолжности.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не выбрано ни одной должности.'"));
		Возврат;
	КонецЕсли;
	МассивВыбранных = Новый Массив;
	Для Каждого Строка Из ВыбранныеДолжности Цикл
		МассивВыбранных.Добавить(Строка.Должность);
	КонецЦикла;
	ОповеститьОВыборе(МассивВыбранных);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция КодДолжностиПоСсылке(Ссылка)
	Возврат Ссылка.КодДолжности;
КонецФункции

&НаКлиенте
Процедура ДобавитьДолжностьВВыбранные(Ссылка)
	Для Каждого Строка Из ВыбранныеДолжности Цикл
		Если Строка.Должность = Ссылка Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	НоваяСтрока = ВыбранныеДолжности.Добавить();
	НоваяСтрока.Должность = Ссылка;
	НоваяСтрока.КодДолжности = КодДолжностиПоСсылке(Ссылка);
КонецПроцедуры

&НаСервере
Процедура ВыбратьВсехНаСервере()
	Выборка = Справочники.Должности.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.ЭтоГруппа Тогда
			Продолжить;
		КонецЕсли;
		УжеЕсть = ВыбранныеДолжности.Найти(Выборка.Ссылка, "Должность");
		Если УжеЕсть = Неопределено Тогда
			НоваяСтрока = ВыбранныеДолжности.Добавить();
			НоваяСтрока.Должность = Выборка.Ссылка;
			НоваяСтрока.КодДолжности = Выборка.КодДолжности;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти
