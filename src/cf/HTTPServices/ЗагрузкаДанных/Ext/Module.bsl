Функция LoadLoad(Запрос) Экспорт
	Попытка
		ДемоДанныеСервер.ЗагрузитьДемоДанные();
	Исключение
		Ответ = Новый HTTPСервисОтвет(500);
		Ответ.Заголовки.Вставить("Content-Type", "text/plain; charset=utf-8");
		Ответ.УстановитьТелоИзСтроки(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ответ;
	КонецПопытки;

	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "text/plain; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(ОтчетОДанных());
	Возврат Ответ;
КонецФункции

Функция ОтчетОДанных()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК КоличествоСтран
	|ИЗ
	|	Справочник.СтраныМира
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*)
	|ИЗ
	|	Справочник.Подразделения
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*)
	|ИЗ
	|	Справочник.Должности
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*)
	|ИЗ
	|	Справочник.Сотрудники
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*)
	|ИЗ
	|	Справочник.Надбавки";
	Числа = Новый Массив;
	Для Каждого Строка Из Запрос.Выполнить().Выгрузить() Цикл
		Числа.Добавить(Формат(Строка.КоличествоСтран, "ЧГ=0"));
	КонецЦикла;
	Возврат СтрШаблон("Страны=%1; Подразделения=%2; Должности=%3; Сотрудники=%4; Надбавки=%5",
		Числа[0], Числа[1], Числа[2], Числа[3], Числа[4]);
КонецФункции
