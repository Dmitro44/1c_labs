Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	Если ПустаяСтрока(МетодПриема) Тогда
		МетодПриема = "Обычный";
	КонецЕсли;
	Если ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.Сотрудники") Тогда
		Сотрудник = ДанныеЗаполнения;
	КонецЕсли;
	Если ЗначениеЗаполнено(Сотрудник) И Не ЗначениеЗаполнено(ВидКомплектования) Тогда
		ВидКомплектования = Сотрудник.ВидКомплектования;
	КонецЕсли;
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, СтандартнаяОбработка)
	Если ЗначениеЗаполнено(ДатаУвольнения) И ДатаУвольнения < ДатаПриема Тогда
		Сообщить("Дата увольнения меньше даты приема.");
		Отказ = Истина;
	КонецЕсли;
	Если ЗначениеЗаполнено(КонецИспытательногоСрока)
		И КонецИспытательногоСрока < НачалоИспытательногоСрока Тогда
		Сообщить("Конец испытательного срока меньше начала.");
		Отказ = Истина;
	КонецЕсли;
	Если ЗначениеЗаполнено(ДатаПриема) И ЗначениеЗаполнено(ДатаУвольнения) Тогда
		КоличествоЛет = КоличествоПолныхЛет(ДатаУвольнения, ДатаПриема);
	Иначе
		КоличествоЛет = 0;
	КонецЕсли;
КонецПроцедуры

Функция КоличествоПолныхЛет(ДатаКонца, ДатаНачала)
	Лет = Год(ДатаКонца) - Год(ДатаНачала);
	Если Месяц(ДатаКонца) < Месяц(ДатаНачала)
		ИЛИ (Месяц(ДатаКонца) = Месяц(ДатаНачала) И День(ДатаКонца) < День(ДатаНачала)) Тогда
		Лет = Лет - 1;
	КонецЕсли;
	Возврат Лет;
КонецФункции

