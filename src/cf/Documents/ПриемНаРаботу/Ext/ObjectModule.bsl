Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	// При приеме могли изменить вид договора — фиксируем его в карточке сотрудника.
	ОбновитьВидКомплектованияСотрудника();

	Движения.РегистрНакопленияНадбавок.Записывать = Истина;
	Движения.РегистрУчетаСотрудников.Записывать = Истина;
	Движения.РегистрРаботыСоШтатнымРасписанием.Записывать = Истина;
	Движения.РегистрУчетаСовмещений.Записывать = Истина;
	Движения.Комплектование.Записывать = Истина;

	ДатаПриемаДляДвижений = ?(ЗначениеЗаполнено(ДатаПриема), ДатаПриема, Дата);

	// 1. Учет сотрудников: приход ставки при приеме
	Если ЗначениеЗаполнено(Сотрудник) Тогда
		Запись = Движения.РегистрУчетаСотрудников.Добавить();
		Запись.ВидДвижения       = ВидДвиженияНакопления.Приход;
		Запись.Период            = ДатаПриемаДляДвижений;
		Запись.Сотрудники        = Сотрудник;
		Запись.Подразделения     = Подразделение;
		Запись.Должности         = Должность;
		Запись.ВидФинансирования = ВидФинансирования;
		Запись.ВидыРаботы        = ВидРаботы;
		Запись.ДокументИзменения = Ссылка;
		Запись.Ставка            = Ставка;

		// при увольнении — расход ставки периодом увольнения
		Если ЗначениеЗаполнено(ДатаУвольнения) Тогда
			Запись = Движения.РегистрУчетаСотрудников.Добавить();
			Запись.ВидДвижения       = ВидДвиженияНакопления.Расход;
			Запись.Период            = ДатаУвольнения;
			Запись.Сотрудники        = Сотрудник;
			Запись.Подразделения     = Подразделение;
			Запись.Должности         = Должность;
			Запись.ВидФинансирования = ВидФинансирования;
			Запись.ВидыРаботы        = ВидРаботы;
			Запись.ДокументИзменения = Ссылка;
			Запись.Ставка            = Ставка;
		КонецЕсли;

		// 2. Комплектование: вид договора и период работы
		Запись = Движения.Комплектование.Добавить();
		Запись.Период            = ДатаПриемаДляДвижений;
		Запись.Сотрудник         = Сотрудник;
		Запись.ВидКомплектования = ВидКомплектования;
		Запись.ДатаНачала        = ДатаПриема;
		Запись.ДатаОкончания     = ДатаУвольнения;
	КонецЕсли;

	// 3. Минус ставки по должности в штатном расписании
	Если ЗначениеЗаполнено(Должность) И Ставка > 0 Тогда
		Запись = Движения.РегистрРаботыСоШтатнымРасписанием.Добавить();
		Запись.ВидДвижения       = ВидДвиженияНакопления.Расход;
		Запись.Период            = ДатаПриемаДляДвижений;
		Запись.Подразделения     = Подразделение;
		Запись.Должности         = Должность;
		Запись.ВидФинансирования = ВидФинансирования;
		Запись.Ставка            = Ставка;
	КонецЕсли;

	// 4. Совмещение: вид доплаты и дата ее окончания
	Если ЗначениеЗаполнено(ВидДоплатыЗаСовмещение) Тогда
		Запись = Движения.РегистрУчетаСовмещений.Добавить();
		Запись.Период            = ДатаПриемаДляДвижений;
		Запись.Сотрудники        = Сотрудник;
		Запись.Подразделения     = Подразделение;
		Запись.Должности         = Должность;
		Запись.ВидФинансирования = ВидФинансирования;
		Запись.ВидыРаботы        = ВидРаботы;
		Запись.Ставка            = Ставка;
		Запись.ВидДоплатыЗаСовмещение = ВидДоплатыЗаСовмещение;
		Запись.ДатаОкончанияДоплатыЗаСовмещение = ДатаОкончанияДоплатыЗаСовмещение;
	КонецЕсли;

	// 7. Надбавки
	Для Каждого СтрокаНадбавки Из Надбавки Цикл
		Если Не ЗначениеЗаполнено(СтрокаНадбавки.Надбавка) Тогда
			Продолжить;
		КонецЕсли;
		Запись = Движения.РегистрНакопленияНадбавок.Добавить();
		Запись.Период      = Дата;
		Запись.Сотрудник   = Сотрудник;
		Запись.Надбавка    = СтрокаНадбавки.Надбавка;
		Запись.ЕдИзм       = СтрокаНадбавки.ЕдИзм;
		Запись.Размер      = СтрокаНадбавки.Размер;
		Запись.ДатаНачала  = СтрокаНадбавки.Начало;
		Запись.ДатаОкончания = СтрокаНадбавки.Конец;
	КонецЦикла;

КонецПроцедуры

// Записывает выбранный вид комплектования в карточку сотрудника,
// чтобы его использовали отчеты (например, «Работающие сотрудники»).
Процедура ОбновитьВидКомплектованияСотрудника()

	Если Не ЗначениеЗаполнено(Сотрудник) ИЛИ Не ЗначениеЗаполнено(ВидКомплектования) Тогда
		Возврат;
	КонецЕсли;

	Если Сотрудник.ВидКомплектования = ВидКомплектования Тогда
		Возврат;
	КонецЕсли;

	СотрудникОбъект = Сотрудник.ПолучитьОбъект();
	Если СотрудникОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СотрудникОбъект.ВидКомплектования = ВидКомплектования;
	СотрудникОбъект.Записать();

КонецПроцедуры
