#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗаполнитьСтавки();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Выбрать(Команда)

	ТекущаяСтавка = Элементы.Ставки.ТекущиеДанные;
	Если ТекущаяСтавка = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите ставку в таблице.'"));
		Возврат;
	КонецЕсли;

	РезультатВыбора = Новый Структура(
		"Подразделение, Должность, ВидФинансирования, Ставка, Оклад",
		ТекущаяСтавка.Подразделение,
		ТекущаяСтавка.Должность,
		ТекущаяСтавка.ВидФинансирования,
		ТекущаяСтавка.Ставка,
		ТекущаяСтавка.Оклад);

	ОповеститьОВыборе(РезультатВыбора);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заполняет таблицу свободными (вакантными) ставками — остатками регистра
// накопления «Регистр работы со штатным расписанием» на конец дня.
// Отбор по подразделению и должности применяется, только если они переданы.
&НаСервере
Процедура ЗаполнитьСтавки()

	Ставки.Очистить();

	Если Параметры.Свойство("ДатаОстатков") И ЗначениеЗаполнено(Параметры.ДатаОстатков) Тогда
		ДатаОстатков = КонецДня(Параметры.ДатаОстатков);
	Иначе
		ДатаОстатков = КонецДня(ТекущаяДатаСеанса());
	КонецЕсли;

	ОтборПодразделение = Неопределено;
	Если Параметры.Свойство("Подразделение") Тогда
		ОтборПодразделение = Параметры.Подразделение;
	КонецЕсли;

	ОтборДолжность = Неопределено;
	Если Параметры.Свойство("Должность") Тогда
		ОтборДолжность = Параметры.Должность;
	КонецЕсли;

	// Отбор применяется только по заполненным полям.
	УсловияОтбора = Новый Массив;
	Если ЗначениеЗаполнено(ОтборПодразделение) Тогда
		УсловияОтбора.Добавить("Остатки.Подразделения = &Подразделение");
	КонецЕсли;
	Если ЗначениеЗаполнено(ОтборДолжность) Тогда
		УсловияОтбора.Добавить("Остатки.Должности = &Должность");
	КонецЕсли;

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Остатки.Подразделения КАК Подразделение,
	|	Остатки.Должности КАК Должность,
	|	Остатки.ВидФинансирования КАК Финансирование,
	|	Остатки.СтавкаОстаток КАК Ставка,
	|	ЕСТЬNULL(ДанныеВвода.Разряд, 0) КАК Разряд,
	|	ЕСТЬNULL(ДанныеВвода.Оклад, 0) КАК Оклад
	|ИЗ
	|	РегистрНакопления.РегистрРаботыСоШтатнымРасписанием.Остатки(&ДатаОстатков, ) КАК Остатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ (
	|			ВЫБРАТЬ
	|				СтрокиВвода.Подразделение КАК Подразделение,
	|				СтрокиВвода.Должность КАК Должность,
	|				СтрокиВвода.ВидФинансирования КАК Финансирование,
	|				МАКСИМУМ(СтрокиВвода.Разряд) КАК Разряд,
	|				МАКСИМУМ(СтрокиВвода.Оклад) КАК Оклад
	|			ИЗ
	|				Документ.ВводШтатнойЕдиницы.ШтатныеЕдиницы КАК СтрокиВвода
	|			ГДЕ
	|				СтрокиВвода.Ссылка.Проведен
	|			СГРУППИРОВАТЬ ПО
	|				СтрокиВвода.Подразделение,
	|				СтрокиВвода.Должность,
	|				СтрокиВвода.ВидФинансирования
	|		) КАК ДанныеВвода
	|	ПО Остатки.Подразделения = ДанныеВвода.Подразделение
	|		И Остатки.Должности = ДанныеВвода.Должность
	|		И Остатки.ВидФинансирования = ДанныеВвода.Финансирование
	|ГДЕ
	|	Остатки.СтавкаОстаток > 0";

	Если УсловияОтбора.Количество() > 0 Тогда
		ТекстЗапроса = ТекстЗапроса + "
	|	И " + СтрСоединить(УсловияОтбора, "
	|	И ");
	КонецЕсли;

	ТекстЗапроса = ТекстЗапроса + "
	|УПОРЯДОЧИТЬ ПО
	|	Подразделение,
	|	Должность,
	|	Финансирование";

	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДатаОстатков", ДатаОстатков);
	Запрос.УстановитьПараметр("Подразделение", ОтборПодразделение);
	Запрос.УстановитьПараметр("Должность", ОтборДолжность);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаСтавки = Ставки.Добавить();
		СтрокаСтавки.Подразделение     = Выборка.Подразделение;
		СтрокаСтавки.Должность         = Выборка.Должность;
		СтрокаСтавки.ВидФинансирования = Выборка.Финансирование;
		СтрокаСтавки.Разряд            = Выборка.Разряд;
		СтрокаСтавки.Ставка            = Выборка.Ставка;
		СтрокаСтавки.Оклад             = Выборка.Оклад;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
