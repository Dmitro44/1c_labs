#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗаполнитьОтсутствующих();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Выбрать(Команда)

	ВыделенныеСтроки = Элементы.Отсутствующие.ВыделенныеСтроки;
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не выбран ни один сотрудник.'"));
		Возврат;
	КонецЕсли;

	СтрокаВыбора = Отсутствующие[ВыделенныеСтроки[0]];
	РезультатВыбора = Новый Структура(
		"Сотрудник, Подразделение, Должность, ВидФинансирования, ВидРаботы, ПричинаОтсутствия",
		СтрокаВыбора.Сотрудник,
		СтрокаВыбора.Подразделение,
		СтрокаВыбора.Должность,
		СтрокаВыбора.ВидФинансирования,
		СтрокаВыбора.ВидРаботы,
		СтрокаВыбора.ПричинаОтсутствия);

	ОповеститьОВыборе(РезультатВыбора);
	Закрыть();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьОтсутствующих()

	Отсутствующие.Очистить();

	// Отсутствия берём из двух источников: регистр «Отпуск»
	// и табличная часть документов «Больничные».
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Отпуска.Сотрудник КАК Сотрудник,
	|	Отпуска.ДатаНачала КАК ДатаНачала,
	|	ЛОЖЬ КАК ЭтоБольничный
	|ИЗ
	|	РегистрСведений.Отпуск КАК Отпуска
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Больничные.Сотрудник,
	|	Больничные.С,
	|	ИСТИНА
	|ИЗ
	|	Документ.Больничные.Сотрудники КАК Больничные
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сотрудник,
	|	ДатаНачала УБЫВ";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаОтсутствия = Отсутствующие.Добавить();
		СтрокаОтсутствия.Сотрудник = Выборка.Сотрудник;
		СтрокаОтсутствия.ПричинаОтсутствия = ?(Выборка.ЭтоБольничный,
			Справочники.ПричинаОтсутствия.Больничный,
			Справочники.ПричинаОтсутствия.Отпуск);
	КонецЦикла;

	ЗаполнитьМестаРаботы();
	ЗаполнитьКоличествоЗамещающих();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьМестаРаботы()

	Если Отсутствующие.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// Текущее место работы и условия приёма — из остатков регистра учета сотрудников.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Сотрудники КАК Сотрудник,
	|	Остатки.Подразделения КАК Подразделение,
	|	Остатки.Должности КАК Должность,
	|	Остатки.ВидФинансирования КАК ВидФинансирования,
	|	Остатки.ВидыРаботы КАК ВидРаботы,
	|	Остатки.СтавкаОстаток КАК Ставка
	|ИЗ
	|	РегистрНакопления.РегистрУчетаСотрудников.Остатки(&Дата, ) КАК Остатки
	|ГДЕ
	|	Остатки.СтавкаОстаток > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сотрудник,
	|	Подразделение,
	|	Должность";
	Запрос.УстановитьПараметр("Дата", КонецДня(ТекущаяДатаСеанса()));

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Для Каждого СтрокаОтсутствия Из Отсутствующие Цикл
			Если СтрокаОтсутствия.Сотрудник = Выборка.Сотрудник
				И Не ЗначениеЗаполнено(СтрокаОтсутствия.Подразделение) Тогда
				СтрокаОтсутствия.Подразделение      = Выборка.Подразделение;
				СтрокаОтсутствия.Должность          = Выборка.Должность;
				СтрокаОтсутствия.ВидФинансирования  = Выборка.ВидФинансирования;
				СтрокаОтсутствия.ВидРаботы          = Выборка.ВидРаботы;
				СтрокаОтсутствия.Ставка             = Выборка.Ставка;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКоличествоЗамещающих()

	Сотрудники = Новый Массив;
	Для Каждого СтрокаОтсутствия Из Отсутствующие Цикл
		Если ЗначениеЗаполнено(СтрокаОтсутствия.Сотрудник) Тогда
			Сотрудники.Добавить(СтрокаОтсутствия.Сотрудник);
		КонецЕсли;
	КонецЦикла;

	Если Сотрудники.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// Сколько раз сотрудника уже принимали на замещение.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Прием.ОтсутствующийСотрудник КАК Сотрудник,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Прием.Ссылка) КАК Количество
	|ИЗ
	|	Документ.ПриемНаРаботу КАК Прием
	|ГДЕ
	|	Прием.МетодПриема = ""Замещение""
	|	И Прием.ОтсутствующийСотрудник В (&Сотрудники)
	|	И Прием.Проведен
	|СГРУППИРОВАТЬ ПО
	|	Прием.ОтсутствующийСотрудник";
	Запрос.УстановитьПараметр("Сотрудники", Сотрудники);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Для Каждого СтрокаОтсутствия Из Отсутствующие Цикл
			Если СтрокаОтсутствия.Сотрудник = Выборка.Сотрудник Тогда
				СтрокаОтсутствия.КолвоЗамещающих = Выборка.Количество;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
