#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗаполнитьОснования();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Выбрать(Команда)

	ВыбранныеОснования = Новый Массив;
	Для Каждого СтрокаОснования Из Основания Цикл
		Если СтрокаОснования.Выбрано Тогда
			ВыбранныеОснования.Добавить(СтрокаОснования.Основание);
		КонецЕсли;
	КонецЦикла;

	Если ВыбранныеОснования.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Не выбрано основание.");
		Возврат;
	КонецЕсли;

	Если ВыбранныеОснования.Количество() > 1 Тогда
		ПоказатьПредупреждение(, "Выберите только одно основание.");
		Возврат;
	КонецЕсли;

	// После ОповеститьОВыборе платформа закрывает форму сама.
	ОповеститьОВыборе(ВыбранныеОснования[0]);

КонецПроцедуры

// Открывает форму элемента справочника «Причина отсутствия»: новое основание
// приема вводится в справочнике, вручную строку в таблицу добавить нельзя.
&НаКлиенте
Процедура ДобавитьОснование(Команда)
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ПослеДобавленияОснования", ЭтотОбъект);
	ОткрытьФорму("Справочник.ПричинаОтсутствия.ФормаОбъекта", , ЭтотОбъект, , , , ОповещениеОЗакрытии);
КонецПроцедуры

&НаКлиенте
Процедура ПослеДобавленияОснования(РезультатЗакрытия, ДопПараметры) Экспорт
	ЗаполнитьОснования();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьОснования()

	Основания.Очистить();

	Выборка = Справочники.ПричинаОтсутствия.Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаОснования = Основания.Добавить();
		СтрокаОснования.Основание = Выборка.Ссылка;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
