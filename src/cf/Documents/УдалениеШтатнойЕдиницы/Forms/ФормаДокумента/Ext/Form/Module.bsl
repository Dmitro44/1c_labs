#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	ПересчитатьИтоги();
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)

	Если ТипЗнч(ВыбранноеЗначение) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ЭлементВыбора Из ВыбранноеЗначение Цикл
		Если ТипЗнч(ЭлементВыбора) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;

		// Одну и ту же штатную единицу дважды не добавляем.
		ЕстьВТаблице = Ложь;
		Для Каждого СтрокаТаблицы Из Объект.ШтатныеЕдиницы Цикл
			Если СтрокаТаблицы.Подразделение = ЭлементВыбора.Подразделение
				И СтрокаТаблицы.Должность = ЭлементВыбора.Должность
				И СтрокаТаблицы.ВидФинансирования = ЭлементВыбора.Финансирование Тогда
				ЕстьВТаблице = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если ЕстьВТаблице Тогда
			Продолжить;
		КонецЕсли;

		Строка = Объект.ШтатныеЕдиницы.Добавить();
		Строка.Подразделение     = ЭлементВыбора.Подразделение;
		Строка.Должность         = ЭлементВыбора.Должность;
		Строка.ВидФинансирования = ЭлементВыбора.Финансирование;
		Строка.Разряд            = ЭлементВыбора.Разряд;
		Строка.Ставка            = ЭлементВыбора.Ставка;
		Строка.Оклад             = ЭлементВыбора.Оклад;
	КонецЦикла;

	ПересчитатьИтоги();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ПересчитатьИтогиПриИзменении(Элемент)
	ПересчитатьИтоги();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Открывает форму подбора свободных ставок на конец дня документа.
// Реквизиты шапки (подразделение, должность, финансирование) передаются как отбор.
&НаКлиенте
Процедура ПодобратьШтатныеЕдиницы(Команда)
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("ДатаОстатков", Объект.Дата);
	ПараметрыОткрытия.Вставить("Подразделение", Объект.Подразделение);
	ПараметрыОткрытия.Вставить("Должность", Объект.Должность);
	ПараметрыОткрытия.Вставить("Финансирование", Объект.Финансирование);
	ОткрытьФорму("Документ.УдалениеШтатнойЕдиницы.Форма.ФормаПодбора", ПараметрыОткрытия, ЭтаФорма);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПересчитатьИтоги()
	Объект.ИтогоОклад = 0;
	Объект.ИтогоСтавок = 0;
	Для Каждого СтрокаШтатнойЕдиницы Из Объект.ШтатныеЕдиницы Цикл
		Объект.ИтогоОклад = Объект.ИтогоОклад + СтрокаШтатнойЕдиницы.Оклад;
		Объект.ИтогоСтавок = Объект.ИтогоСтавок + СтрокаШтатнойЕдиницы.Ставка;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти
