#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Остатки будем смотреть на конец дня документа, для которого подбираем штатные единицы.
	Если Параметры.Свойство("ДатаОстатков") И ЗначениеЗаполнено(Параметры.ДатаОстатков) Тогда
		ДатаОстатков = КонецДня(Параметры.ДатаОстатков);
	Иначе
		ДатаОстатков = КонецДня(ТекущаяДатаСеанса());
	КонецЕсли;

	// Значения из шапки документа используем как начальный отбор.
	Если Параметры.Свойство("Подразделение") Тогда
		ОтборПодразделение = Параметры.Подразделение;
	КонецЕсли;
	Если Параметры.Свойство("Должность") Тогда
		ОтборДолжность = Параметры.Должность;
	КонецЕсли;
	Если Параметры.Свойство("Финансирование") Тогда
		ОтборФинансирование = Параметры.Финансирование;
	КонецЕсли;

	ЗаполнитьСписокШтатныхЕдиниц();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ОбновитьСписокПриИзменении(Элемент)
	ЗаполнитьСписокШтатныхЕдиниц();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Выбрать(Команда)

	ВыбранныеСтроки = Новый Массив;
	Для Каждого Строка Из ШтатныеЕдиницы Цикл
		Если Строка.Пометка Тогда
			ВыбранныеСтроки.Добавить(Новый Структура(
				"Финансирование, Подразделение, Должность, Разряд, Ставка, Оклад",
				Строка.Финансирование, Строка.Подразделение, Строка.Должность,
				Строка.Разряд, Строка.Ставка, Строка.Оклад));
		КонецЕсли;
	КонецЦикла;

	Если ВыбранныеСтроки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Не отмечено ни одной штатной единицы.");
		Возврат;
	КонецЕсли;

	// После ОповеститьОВыборе платформа закрывает форму выбора сама,
	// повторный вызов Закрыть() приводит к ошибке «форма не открыта».
	ОповеститьОВыборе(ВыбранныеСтроки);

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписок(Команда)
	ЗаполнитьСписокШтатныхЕдиниц();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заполняет таблицу свободными ставками — остатками регистра накопления
// «Регистр работы со штатным расписанием» на конец дня документа.
&НаСервере
Процедура ЗаполнитьСписокШтатныхЕдиниц()

	ШтатныеЕдиницы.Очистить();

	// Отбор применяется только по заполненным полям.
	УсловияОтбора = Новый Массив;
	Если ЗначениеЗаполнено(ОтборПодразделение) Тогда
		УсловияОтбора.Добавить("Остатки.Подразделения = &Подразделение");
	КонецЕсли;
	Если ЗначениеЗаполнено(ОтборДолжность) Тогда
		УсловияОтбора.Добавить("Остатки.Должности = &Должность");
	КонецЕсли;
	Если ЗначениеЗаполнено(ОтборФинансирование) Тогда
		УсловияОтбора.Добавить("Остатки.ВидФинансирования = &Финансирование");
	КонецЕсли;

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Остатки.Подразделения КАК Подразделение,
	|	Остатки.Должности КАК Должность,
	|	Остатки.ВидФинансирования КАК Финансирование,
	|	Остатки.СтавкаОстаток КАК Ставка,
	|	ЕСТЬNULL(ДанныеВвода.Разряд, 0) КАК Разряд,
	|	ЕСТЬNULL(ДанныеВвода.Оклад, 0) КАК Оклад
	|ИЗ
	|	РегистрНакопления.РегистрРаботыСоШтатнымРасписанием.Остатки(&ДатаОстатков, ) КАК Остатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ (
	|			ВЫБРАТЬ
	|				СтрокиВвода.Подразделение КАК Подразделение,
	|				СтрокиВвода.Должность КАК Должность,
	|				СтрокиВвода.ВидФинансирования КАК Финансирование,
	|				МАКСИМУМ(СтрокиВвода.Разряд) КАК Разряд,
	|				МАКСИМУМ(СтрокиВвода.Оклад) КАК Оклад
	|			ИЗ
	|				Документ.ВводШтатнойЕдиницы.ШтатныеЕдиницы КАК СтрокиВвода
	|			ГДЕ
	|				СтрокиВвода.Ссылка.Проведен
	|			СГРУППИРОВАТЬ ПО
	|				СтрокиВвода.Подразделение,
	|				СтрокиВвода.Должность,
	|				СтрокиВвода.ВидФинансирования
	|		) КАК ДанныеВвода
	|	ПО Остатки.Подразделения = ДанныеВвода.Подразделение
	|		И Остатки.Должности = ДанныеВвода.Должность
	|		И Остатки.ВидФинансирования = ДанныеВвода.Финансирование
	|ГДЕ
	|	Остатки.СтавкаОстаток > 0";

	Если УсловияОтбора.Количество() > 0 Тогда
		ТекстЗапроса = ТекстЗапроса + "
	|	И " + СтрСоединить(УсловияОтбора, "
	|	И ");
	КонецЕсли;

	ТекстЗапроса = ТекстЗапроса + "
	|УПОРЯДОЧИТЬ ПО
	|	Подразделение,
	|	Должность,
	|	Финансирование";

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ДатаОстатков", ДатаОстатков);
	Запрос.УстановитьПараметр("Подразделение", ОтборПодразделение);
	Запрос.УстановитьПараметр("Должность", ОтборДолжность);
	Запрос.УстановитьПараметр("Финансирование", ОтборФинансирование);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = ШтатныеЕдиницы.Добавить();
		Строка.Подразделение  = Выборка.Подразделение;
		Строка.Должность      = Выборка.Должность;
		Строка.Финансирование = Выборка.Финансирование;
		Строка.Разряд         = Выборка.Разряд;
		Строка.Ставка         = Выборка.Ставка;
		Строка.Оклад          = Выборка.Оклад;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
