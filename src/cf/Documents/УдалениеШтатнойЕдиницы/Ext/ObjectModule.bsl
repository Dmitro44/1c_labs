	ИтогоОклад = 0;
	ИтогоСтавок = 0;
	Для Каждого СтрокаШтатнойЕдиницы Из ШтатныеЕдиницы Цикл
		ИтогоОклад = ИтогоОклад + СтрокаШтатнойЕдиницы.Оклад;
		ИтогоСтавок = ИтогоСтавок + СтрокаШтатнойЕдиницы.Ставка;
	КонецЦикла;
