// Формирует отрицательные движения по регистру
// «Регистр работы со штатным расписанием» — удаление штатных единиц.
Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Движения.РегистрРаботыСоШтатнымРасписанием.Записывать = Истина;

	Для Каждого СтрокаШтатнойЕдиницы Из ШтатныеЕдиницы Цикл

		Если Не ЗначениеЗаполнено(СтрокаШтатнойЕдиницы.Подразделение) Тогда
			Продолжить;
		КонецЕсли;

		Запись = Движения.РегистрРаботыСоШтатнымРасписанием.Добавить();
		Запись.ВидДвижения      = ВидДвиженияНакопления.Расход;
		Запись.Период           = Дата;
		Запись.ВидФинансирования = СтрокаШтатнойЕдиницы.ВидФинансирования;
		Запись.Подразделения    = СтрокаШтатнойЕдиницы.Подразделение;
		Запись.Должности        = СтрокаШтатнойЕдиницы.Должность;
		Запись.Ставка           = СтрокаШтатнойЕдиницы.Ставка;

	КонецЦикла;

КонецПроцедуры
