#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Для Каждого СтрокаБольничного Из Объект.Сотрудники Цикл
		Если СтрокаБольничного.По < СтрокаБольничного.С Тогда
			Сообщить("Дата окончания больничного меньше даты начала у сотрудника "
				+ СтрокаБольничного.Сотрудник + ".");
			Отказ = Истина;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Печать(Команда)
	ТабличныйДокумент = СформироватьПечатнуюФорму();
	ТабличныйДокумент.Показать("Печать: Больничные");
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция СформироватьПечатнуюФорму()

	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ТолькоПросмотр = Истина;
	ТабличныйДокумент.ОтображатьСетку = Ложь;

	ТабличныйДокумент.Область("C1").ШиринаКолонки = 32;
	ТабличныйДокумент.Область("C2").ШиринаКолонки = 12;
	ТабличныйДокумент.Область("C3").ШиринаКолонки = 12;
	ТабличныйДокумент.Область("C4").ШиринаКолонки = 24;

	// Шапка
	ТабличныйДокумент.Область("R1C1:R1C4").Объединить();
	ТабличныйДокумент.Область("R1C1").Текст =
		"Больничные № " + Объект.Номер + " от " + Формат(Объект.Дата, "ДЛФ=D");

	ТабличныйДокумент.Область("R3C1").Текст = "Сотрудник";
	ТабличныйДокумент.Область("R3C2").Текст = "С";
	ТабличныйДокумент.Область("R3C3").Текст = "По";
	ТабличныйДокумент.Область("R3C4").Текст = "Номер больничного";
	ЛинияРамки = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная);
	ОбластьШапки = ТабличныйДокумент.Область("R3C1:R3C4");
	ОбластьШапки.Шрифт = Новый Шрифт(, , Истина);
	ОбластьШапки.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	ОбвестиЯчейкиСтроки(ТабличныйДокумент, 3, 4, ЛинияРамки);

	НомерСтроки = 4;
	Для Каждого СтрокаБольничного Из Объект.Сотрудники Цикл
		ТабличныйДокумент.Область("R" + НомерСтроки + "C1").Текст =
			Строка(СтрокаБольничного.Сотрудник);
		ТабличныйДокумент.Область("R" + НомерСтроки + "C2").Текст =
			Формат(СтрокаБольничного.С, "ДЛФ=D");
		ТабличныйДокумент.Область("R" + НомерСтроки + "C3").Текст =
			Формат(СтрокаБольничного.По, "ДЛФ=D");
		ТабличныйДокумент.Область("R" + НомерСтроки + "C4").Текст =
			СтрокаБольничного.НомерБольничного;
		ОбвестиЯчейкиСтроки(ТабличныйДокумент, НомерСтроки, 4, ЛинияРамки);
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;

	Если Не ПустаяСтрока(Объект.Комментарий) Тогда
		НомерСтроки = НомерСтроки + 1;
		ТабличныйДокумент.Область("R" + НомерСтроки + "C1").Текст =
			"Комментарий: " + Объект.Комментарий;
	КонецЕсли;

	Возврат ТабличныйДокумент;

КонецФункции

// Обводит каждую ячейку строки отдельно: Обвести() на области из нескольких
// ячеек рисует только внешнюю рамку, поэтому внутренние вертикальные линии
// задаём по ячейкам.
&НаСервере
Процедура ОбвестиЯчейкиСтроки(ТабличныйДокумент, НомерСтроки, Колонок, ЛинияРамки)
	Для Колонка = 1 По Колонок Цикл
		ТабличныйДокумент.Область(НомерСтроки, Колонка).Обвести(
			ЛинияРамки, ЛинияРамки, ЛинияРамки, ЛинияРамки);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти
