// Модуль управляемого приложения.
// Позволяет выполнить служебные действия при запуске клиента с параметром /C.
//
// Пример: 1cv8 ENTERPRISE /F <база> /C ЗагрузитьДемоДанные

Процедура ПриНачалеРаботыСистемы()

	Если ПараметрЗапуска = "ЗагрузитьДемоДанные" Тогда
		ВыполнитьЗагрузкуДемоДанныхИЗавершить();
	КонецЕсли;

КонецПроцедуры

Процедура ВыполнитьЗагрузкуДемоДанныхИЗавершить()

	Попытка
		ДемоДанныеСервер.ЗагрузитьДемоДанные();
	Исключение
		Сообщить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	ЗавершитьРаботуСистемы(Ложь);

КонецПроцедуры
